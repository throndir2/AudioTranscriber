<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AudioTranscriber.UiMcp</AssemblyName>
    <RootNamespace>AudioTranscriber.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\..\src\AudioTranscriber.Application\AudioTranscriber.Application.csproj" />
    <Compile Include="..\..\src\AudioTranscriber.App\Mcp\McpStdioServer.cs" Link="Mcp\McpStdioServer.cs" />
    <Compile Include="..\..\src\AudioTranscriber.App\Mcp\AudioFilePlayer.cs" Link="Mcp\AudioFilePlayer.cs" />
    <Compile Include="..\..\src\AudioTranscriber.App\StartupOptions.cs" Link="StartupOptions.cs" />
  </ItemGroup>
</Project>
