<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- WPF package pruning differs on Linux; retain locked restores on both hosts. -->
    <NuGetLockFilePath Condition="$([MSBuild]::IsOSPlatform('Linux'))">packages.linux.lock.json</NuGetLockFilePath>
    <AssemblyName>AudioTranscriber.App</AssemblyName>
    <RootNamespace>AudioTranscriber.App</RootNamespace>
    <!-- Regenerate with scripts\New-AppIcon.ps1. WPF windows fall back to this assembly icon. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioTranscriber.Application\AudioTranscriber.Application.csproj" />
    <!-- Native GPU runtime ships via build/ targets, which do not flow transitively. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>
</Project>
