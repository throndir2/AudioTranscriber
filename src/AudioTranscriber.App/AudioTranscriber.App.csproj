    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>AudioTranscriber.App</AssemblyName>
    <RootNamespace>AudioTranscriber.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioTranscriber.Application\AudioTranscriber.Application.csproj" />
  </ItemGroup>
</Project>
