<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <AssemblyName>AudioTranscriber.App</AssemblyName>
    <RootNamespace>AudioTranscriber.App</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\AppIcon.ico" />
    <AvaloniaResource Include="Assets\AppIcon.png" />
    <ProjectReference Include="..\AudioTranscriber.Application\AudioTranscriber.Application.csproj" />
    <ProjectReference Include="..\AudioTranscriber.Storage\AudioTranscriber.Storage.csproj" />
    <ProjectReference Include="..\AudioTranscriber.Integrations\AudioTranscriber.Integrations.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <ProjectReference Include="..\AudioTranscriber.Discord\AudioTranscriber.Discord.csproj" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>


