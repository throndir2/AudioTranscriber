<Window x:Class="AudioTranscriber.App.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AudioTranscriber.App"
        Title="AudioTranscriber · Local audio library"
        Width="1440" Height="940" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppIcon.ico">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
    <!-- Title bar: brand, selected session, recording state and controls; on Windows it also carries the window buttons. -->
    <Border Height="40" Background="{StaticResource TitleBarFill}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
            Win32Properties.NonClientHitTestResult="Caption">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Classes="winonly" Margin="4,0,0,0" Win32Properties.NonClientHitTestResult="Client">
          <Button Classes="caption" Content="&#xE921;" Click="MinimizeClick" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize" />
          <Button x:Name="MaximizeButton" Classes="caption" Content="&#xE922;" Click="MaximizeClick" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize" />
          <Button Classes="caption close" Content="&#xE8BB;" Click="CloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Win32Properties.NonClientHitTestResult="Client">
          <Border Classes="pill" Classes.recording="{Binding IsRecording}" Classes.stopping="{Binding Stopping}"
                  ToolTip.Tip="Recording state. Stop seals the original audio; it does not cancel transcription. This stays here on every tab.">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Classes="dot" />
              <TextBlock Classes="state" Text="{Binding CaptureState}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Classes="session" Text="{Binding RecordingSession}" />
            </StackPanel>
          </Border>
          <Button Content="●  Record" Command="{Binding StartRecordingCommand}" Classes="record" IsVisible="{Binding !IsRecording}"
                  MinHeight="28" Padding="12,2" Margin="0,0,8,0" AutomationProperties.Name="Quick start recording"
                  ToolTip.Tip="Start a new recording now with the settings on Record / import (defaults work as-is)." />
          <Button Content="■  Stop recording" Command="{Binding StopRecordingCommand}" Classes="stop" IsVisible="{Binding IsRecording}"
                  MinHeight="28" Padding="12,2" Margin="0,0,8,0" ToolTip.Tip="Stops and seals audio. Does not cancel transcription." />
          <Button Content="{Binding RestartToUpdateLabel}" Command="{Binding RestartToUpdateCommand}" Classes="primary" IsVisible="{Binding UpdateReady}"
                  MinHeight="28" Padding="12,2" Margin="0,0,8,0"
                  ToolTip.Tip="A verified update is downloaded. Closes the app (finishing any recording safely), installs the update, and reopens it. Otherwise it installs the next time you close the app." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <!-- The app icon's waveform bars and transcript lines (scripts\New-AppIcon.ps1 geometry), without its tile. -->
          <Viewbox Height="22" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="AudioTranscriber logo">
            <Canvas Width="158" Height="140">
              <Rectangle Canvas.Left="0" Canvas.Top="40" Width="20" Height="60" RadiusX="10" RadiusY="10" Fill="{StaticResource LogoBar}" />
              <Rectangle Canvas.Left="30" Canvas.Top="0" Width="20" Height="140" RadiusX="10" RadiusY="10" Fill="{StaticResource LogoBar}" />
              <Rectangle Canvas.Left="60" Canvas.Top="24" Width="20" Height="92" RadiusX="10" RadiusY="10" Fill="{StaticResource LogoBar}" />
              <Rectangle Canvas.Left="96" Canvas.Top="25" Width="62" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource LogoLine}" />
              <Rectangle Canvas.Left="96" Canvas.Top="61" Width="62" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource LogoLine}" />
              <Rectangle Canvas.Left="96" Canvas.Top="97" Width="36" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource LogoLine}" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="AudioTranscriber" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                     FontFeatures="{x:Static local:UiFonts.SmallCaps}" Foreground="{StaticResource GoldBright}" />
        </StackPanel>
        <DockPanel Margin="16,0,12,0" VerticalAlignment="Center">
          <Border DockPanel.Dock="Left" Width="1" Height="18" Background="{StaticResource Line}" Margin="0,0,14,0" />
          <TextBlock DockPanel.Dock="Left" MaxWidth="420" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding SelectedSession.Name, TargetNullValue=No session selected, FallbackValue=No session selected}" />
          <TextBlock Text="{Binding SessionSummary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,1,0,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="264,5,*">
      <Border Background="{StaticResource SidebarFill}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="14,10,8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
              <Button Classes="ghost" Command="{Binding MergeSessionsCommand}" AutomationProperties.Name="Merge sessions"
                      ToolTip.Tip="Merge the selected sessions into one">
                <PathIcon Width="13" Height="13" Data="M3,1 L5,1 L5,5 L8,8 L11,5 L11,1 L13,1 L13,6 L9,10 L9,15 L7,15 L7,10 L3,6 Z" />
              </Button>
              <Button Classes="ghost" Command="{Binding DeleteSessionsCommand}" AutomationProperties.Name="Delete sessions" ToolTip.Tip="Delete the selected sessions">
                <PathIcon Width="13" Height="13"
                          Data="M5,1 L11,1 L12,2 L16,2 L16,4 L1,4 L1,2 L4,2 Z M3,5 L14,5 L13,17 L4,17 Z M6,7 L7,7 L7,15 L6,15 Z M10,7 L11,7 L11,15 L10,15 Z" />
              </Button>
              <Button Classes="ghost" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh library" ToolTip.Tip="Refresh library">
                <PathIcon Width="13" Height="13" Data="M8,2 A6,6 0 1 0 14,8 L12.5,8 A4.5,4.5 0 1 1 8,3.5 Z M7.5,0 L11,2.75 L7.5,5.5 Z" />
              </Button>
            </StackPanel>
            <local:SectionHeader Text="Your sessions" Margin="0" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Shift/Ctrl-click for several · right-click for actions" Classes="caption" Margin="14,2,14,8" TextTrimming="CharacterEllipsis" />
          <ListBox x:Name="SessionList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionMode="Multiple"
                   Margin="6,0,6,6" Background="Transparent"
                   KeyDown="SessionListKeyDown" SelectionChanged="SessionListSelectionChanged"
                   AutomationProperties.Name="Saved sessions"
                   AutomationProperties.HelpText="Shift-click or Ctrl-click to select several sessions. Right-click the selection, or press Delete, to merge or delete it.">
            <ListBox.ContextMenu><ContextMenu AutomationProperties.Name="Session actions" /></ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11.5" Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding CreatedUtc, StringFormat='{}{0:MMM d · HH:mm}'}" Foreground="{StaticResource Dim}" FontSize="12" />
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Border Background="#2A1311" BorderBrush="#6E2620" BorderThickness="0,0,0,1" Padding="14,7"
                IsVisible="{Binding SessionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{StaticResource ErrorText}"
                      Data="F1 M8,1 L15.5,14.5 L0.5,14.5 Z M7.25,5.5 L8.75,5.5 L8.6,10.5 L7.4,10.5 Z M7.25,11.75 L8.75,11.75 L8.75,13.25 L7.25,13.25 Z" />
            <TextBlock Text="{Binding SessionError}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
          <TabItem Header="Record / import" Tag="&#xE720;">
            <Grid Margin="16,14,16,4" ColumnDefinitions="3*,16,2*">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="card hero">
                  <StackPanel>
                    <local:SectionHeader Text="Start with your audio" />
                    <TextBlock Classes="help" Text="Just press Start recording: defaults are ready. Output and microphone are archived as separate tracks; originals survive slow or unavailable transcription." />
                    <WrapPanel>
                      <Button Content="●  Start recording" Classes="primary" Command="{Binding StartRecordingCommand}" />
                      <Button Content="{Binding ContinueRecordingLabel}" Command="{Binding ContinueRecordingCommand}" />
                      <Button Content="■  Stop recording" Classes="stop" Command="{Binding StopRecordingCommand}" />
                      <Button Content="Import file…" Command="{Binding ImportAudioCommand}"
                              ToolTip.Tip="Import an audio or video file to transcribe, or a WebVTT (.vtt) transcript with its timed lines and speaker labels. Each import becomes a new session." />
                      <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SetupStatus}" IsVisible="{Binding HasSetupStatus}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,6,0">
                    <Border Classes="card">
                      <StackPanel>
                        <local:SectionHeader Text="New session" />
                        <Grid ColumnDefinitions="*,*,120">
                          <StackPanel><TextBlock Classes="caption" Text="Session name" /><TextBox x:Name="SessionNameInput" Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New session name" /></StackPanel>
                          <StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="Transcription provider" /><ComboBox x:Name="ProviderInput" ItemsSource="{Binding Providers}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedProvider}" AutomationProperties.Name="New session transcription provider" /></StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="Source language" /><TextBox x:Name="LanguageInput" Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source language" /></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ProviderHelp}" Classes="help" />
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <local:SectionHeader Text="Visible capture" />
                        <Grid ColumnDefinitions="*,16,*">
                          <StackPanel>
                            <TextBlock Classes="caption" Text="Output endpoint" /><ComboBox x:Name="OutputInput" ItemsSource="{Binding OutputDevices}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding OutputDevice}" AutomationProperties.Name="Selected output device" />
                            <ProgressBar Value="{Binding OutputLevel}" Minimum="0" Maximum="1" Height="10" AutomationProperties.Name="Output capture peak level" />
                            <TextBlock Classes="caption" Text="Pause that ends a phrase" Margin="0,8,0,0" />
                            <DockPanel><TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" Text="{Binding PhrasePauseMilliseconds, StringFormat='{}{0} ms'}" /><Slider x:Name="PhrasePauseInput" Minimum="200" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding PhrasePauseMilliseconds}" AutomationProperties.Name="Silence in milliseconds that ends a live transcript phrase" /></DockPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <CheckBox Content="Include a separate microphone track" IsChecked="{Binding MicrophoneEnabled}" />
                            <ComboBox ItemsSource="{Binding MicrophoneDevices}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding MicrophoneDevice}" IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="Optional separate microphone device" />
                            <CheckBox Content="Reduce echo from speakers" IsChecked="{Binding ReduceEcho}" IsEnabled="{Binding MicrophoneEnabled}" />
                            <TextBlock Classes="caption" Text="Label microphone lines as" /><TextBox x:Name="MicrophoneNameInput" Text="{Binding MicrophoneName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="Speaker name for microphone lines" />
                            <ProgressBar Value="{Binding MicrophoneLevel}" Minimum="0" Maximum="1" Height="10" AutomationProperties.Name="Microphone capture peak level" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <local:SectionHeader Text="Live transcript file" />
                        <CheckBox IsChecked="{Binding LiveFileEnabled}" AutomationProperties.Name="Mirror new sessions to a live transcript file" Content="Write transcript to a live text file" />
                        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseLiveFileCommand}" /><TextBox Text="{Binding LiveFilePath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Live transcript folder or file path" ToolTip.Tip="A folder gets one file per session, named after the session. A path that ends in a file name, such as .txt, is used as one fixed file." /></DockPanel>
                        <TextBlock Text="{Binding LiveFileStatus}" Classes="caption" />
                      </StackPanel>
                    </Border>
                    <Border Classes="card warning">
                      <StackPanel>
                        <local:SectionHeader Text="Optional NVIDIA upload — this new session only" Foreground="#F2B3A8" />
                        <TextBlock Classes="help" Text="If enabled, audio for this session may be sent to the selected NVIDIA-hosted ASR service. Local Parakeet never uploads." />
                        <CheckBox IsChecked="{Binding NewCloudConsent}" AutomationProperties.Name="Explicit NVIDIA upload consent for this new session" Content="I explicitly permit NVIDIA uploads for this new session." />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
              <Border Grid.Column="2" Classes="card">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}" /><Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyActivityCommand}" /><local:SectionHeader Text="Live activity" /></DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="caption" Text="Shows capture, jobs, transcript lines, errors and live file writes." Margin="0,0,0,10" />
                  <ListBox x:Name="ActivityList" ItemsSource="{Binding ActivityLog}" MinHeight="160" Background="{StaticResource InputBg}" AutomationProperties.Name="Live activity log">
                    <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="62,*"><TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Dim}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" /></Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Transcript" Tag="&#xE8A5;">
            <Grid Margin="12,10" RowDefinitions="Auto,Auto,2*,8,*">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearSearchCommand}" />
                <Button DockPanel.Dock="Right" Content="Find / jump" Command="{Binding SearchCommand}" />
                <TextBox DockPanel.Dock="Right" Width="86" Text="{Binding Seek, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Jump to transcript timestamp" ToolTip.Tip="Jump to a time: seconds, mm:ss or hh:mm:ss"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings></TextBox>
                <TextBlock DockPanel.Dock="Right" Text="Jump" Foreground="{StaticResource Muted}" Margin="6,0" VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding SpeakerFilters}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SpeakerFilter}" AutomationProperties.Name="Transcript speaker filter" />
                <TextBlock DockPanel.Dock="Right" Text="Speaker" Foreground="{StaticResource Muted}" Margin="6,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Classes="glyph" Text="&#xE721;" Foreground="{StaticResource Gold}" Margin="2,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Search" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search transcript text"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings></TextBox>
              </DockPanel>
              <DockPanel Grid.Row="1" Margin="0,2,0,6">
                <Button DockPanel.Dock="Right" Content="Export…" Command="{Binding ExportCommand}" />
                <Button DockPanel.Dock="Right" Content="Stop live file" Command="{Binding StopLiveFileCommand}" />
                <Button DockPanel.Dock="Right" Content="Live file" Command="{Binding LiveMirrorSelectedCommand}" />
                <Button DockPanel.Dock="Right" Content="Re-transcribe…" Command="{Binding ResplitCommand}" />
                <Button DockPanel.Dock="Right" Content="Analyze speakers" Command="{Binding DiarizeCommand}" />
                <Button DockPanel.Dock="Right" Content="Fill speakers from my labels" Classes="primary" Command="{Binding FillSpeakersCommand}" />
                <TextBlock Text="{Binding TranscriptSummary}" Classes="caption" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <DataGrid x:Name="TranscriptGrid" Grid.Row="2" ItemsSource="{Binding Transcript}" SelectedItem="{Binding SelectedRow}" SelectionMode="Extended" RowHeight="NaN" SelectionChanged="TranscriptSelectionChanged" DoubleTapped="TranscriptDoubleTapped" AutomationProperties.Name="Transcript lines" AutomationProperties.HelpText="Right-click lines to set or rename the speaker. Ctrl/Shift-click to select several. Double-click plays a line.">
                <DataGrid.ContextMenu><ContextMenu AutomationProperties.Name="Transcript line actions" /></DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="96" />
                  <DataGridTextColumn Header="Track" Binding="{Binding TrackName}" Width="110" />
                  <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="130" />
                  <DataGridTextColumn Header="Transcript" Binding="{Binding Text}" Width="*" MinWidth="160" />
                  <DataGridTextColumn Header="Timing" Binding="{Binding Timing}" Width="104" />
                  <DataGridTextColumn Header="Attribution" Binding="{Binding Attribution}" Width="140" />
                </DataGrid.Columns>
              </DataGrid>
              <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
              <TabControl Grid.Row="4">
                <TabItem Header="Selected line" x:Name="SelectedLineTab">
                  <Grid Margin="8,6" RowDefinitions="Auto,*">
                    <DockPanel><Button DockPanel.Dock="Right" Content="■ Stop" Command="{Binding StopPlaybackCommand}" /><Button DockPanel.Dock="Right" Content="▶ Play" Command="{Binding PlayRowCommand}" /><Button DockPanel.Dock="Right" Content="Restore raw" Command="{Binding RestoreRawCommand}" /><Button DockPanel.Dock="Right" Content="Save text" Command="{Binding SaveCorrectionCommand}" /><TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Muted}" Margin="0,0,8,0" /><ComboBox Width="180" IsEditable="True" local:EditableComboBox.SyncSelection="True" ItemsSource="{Binding SpeakerNames}" Text="{Binding LineSpeaker, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker for selected lines"><ComboBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SetLineSpeakerCommand}" /></ComboBox.KeyBindings></ComboBox><Button Content="Set speaker" Command="{Binding SetLineSpeakerCommand}" /></DockPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,4,0,0"><TextBox x:Name="CorrectionInput" Text="{Binding Correction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Editable transcript correction" /><TextBox Grid.Column="1" Text="{Binding RawText}" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource SurfaceAlt}" Foreground="{StaticResource Muted}" AutomationProperties.Name="Preserved raw recognition" /></Grid>
                  </Grid>
                </TabItem>
                <TabItem Header="Speaker names"><ScrollViewer><StackPanel Margin="8,6"><TextBlock Classes="help" Text="Rename a speaker on every line. Giving two speakers the same name merges them." /><WrapPanel><ComboBox Width="190" ItemsSource="{Binding Speakers}" SelectedItem="{Binding ManagedSpeaker}" DisplayMemberBinding="{Binding Name}" AutomationProperties.Name="Speaker to rename" /><TextBox Width="220" Text="{Binding SpeakerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker display name"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding RenameSpeakerCommand}" /></TextBox.KeyBindings></TextBox><Button Content="Rename throughout session" Command="{Binding RenameSpeakerCommand}" /></WrapPanel><WrapPanel><Button Content="Match known voices" Command="{Binding RecognizeVoicesCommand}" /><Button Content="Remember this session's named voices" Command="{Binding RememberSessionVoicesCommand}" /><Button Content="Name all microphone lines…" Command="{Binding NameMicrophoneLinesCommand}" /></WrapPanel></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Track playback"><ScrollViewer><StackPanel Margin="8,6"><TextBlock Classes="help" Text="Play one original track from a time. Unlinked VTT tracks have no audio." /><WrapPanel><ComboBox Width="260" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberBinding="{Binding Name}" AutomationProperties.Name="Original track to play" /><TextBox Width="140" Text="{Binding PlaybackTimestamp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Original track playback timestamp" /><Button Content="▶ Play track" Command="{Binding PlayTrackCommand}" /><Button Content="■ Stop playback" Command="{Binding StopPlaybackCommand}" /></WrapPanel></StackPanel></ScrollViewer></TabItem>
              </TabControl>
            </Grid>
          </TabItem>

          <TabItem Header="Templates" Tag="&#xE99A;">
            <Grid Margin="16,14,16,4" ColumnDefinitions="*,16,*" DataContext="{Binding Templates}">
              <ScrollViewer><StackPanel Margin="0,0,6,0">
                <Border Classes="card hero"><StackPanel><local:SectionHeader Text="Output templates" /><TextBlock Classes="help" Text="Write prompts that turn the transcript into summaries, guidance, notes, or files. Templates are grouped in folders; select ☆ to keep a template under Favorites." /><TextBlock Text="{Binding TargetDescription}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" /><TreeView x:Name="TemplateTreeInput" ItemsSource="{Binding TemplateTree}" SelectedItem="{Binding SelectedNode}" MinHeight="120" MaxHeight="360" Background="{StaticResource InputBg}" AutomationProperties.Name="Output templates"><TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /></Style></TreeView.Styles><TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><DockPanel Margin="0,0,14,0"><Button DockPanel.Dock="Left" Classes="ghost" Padding="4,0" MinHeight="0" Margin="0,0,4,0" FontSize="15" Foreground="{StaticResource Gold}" Content="{Binding Template.FavoriteGlyph}" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding !IsFolder}" ToolTip.Tip="Add to or remove from Favorites" AutomationProperties.Name="Favorite" /><TextBlock DockPanel.Dock="Right" Text="{Binding Template.Summary}" IsVisible="{Binding !IsFolder}" Foreground="{StaticResource Dim}" Margin="12,0,0,0" /><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" IsVisible="{Binding IsFolder}" Foreground="{StaticResource Dim}" Margin="12,0,0,0" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" IsVisible="{Binding IsFolder}" /><TextBlock Text="{Binding Template.Name}" IsVisible="{Binding !IsFolder}" TextTrimming="CharacterEllipsis" /></DockPanel></TreeDataTemplate></TreeView.ItemTemplate></TreeView><WrapPanel><Button Content="New template" Command="{Binding AddTemplateCommand}" ToolTip.Tip="Add a template to the selected folder" /><Button Content="Duplicate" Command="{Binding DuplicateTemplateCommand}" /><Button Content="Delete…" Command="{Binding DeleteTemplateCommand}" /><Button Content="Add missing built-in templates" Command="{Binding RestoreBuiltInsCommand}" ToolTip.Tip="Bring back starter and TTRPG templates you deleted" /><Button Content="Add table templates" Command="{Binding AddTableStartersCommand}" /></WrapPanel><TextBlock Classes="caption" Text="Template table: one row per template; edit it in Excel, LibreOffice or any editor and the list here follows" Margin="0,6,0,2" /><DockPanel><Button DockPanel.Dock="Right" Content="Open table" Command="{Binding OpenTableCommand}" ToolTip.Tip="Open the table in your spreadsheet app" /><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseTableCommand}" ToolTip.Tip="Link another table file: an existing table is loaded, a new file gets your templates" /><TextBox x:Name="TemplateTableInput" Text="{Binding TablePath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Template table file" /></DockPanel><TextBlock Classes="caption" Text="{Binding ListStatus}" AutomationProperties.LiveSetting="Polite" /></StackPanel></Border>
                <Border Classes="card" IsEnabled="{Binding HasTemplate}"><StackPanel><local:SectionHeader Text="Selected template" /><Grid ColumnDefinitions="*,12,*"><StackPanel><TextBlock Classes="caption" Text="Name" /><TextBox x:Name="TemplateNameInput" Text="{Binding SelectedTemplate.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template name" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="LLM connection" /><DockPanel><Button DockPanel.Dock="Right" Content="Set up…" Click="OpenConnectionsClick" ToolTip.Tip="Add or edit LLM connections on the Privacy / models tab" AutomationProperties.Name="Set up LLM connections" /><ComboBox x:Name="TemplateConnectionInput" ItemsSource="{Binding ConnectionChoices}" DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding SelectedTemplateConnectionId}" ToolTip.Tip="Default uses the connection marked Default in Privacy / models, Template LLM connections. Pick a connection to always use it for this template." AutomationProperties.Name="LLM connection for this template" /></DockPanel></StackPanel></Grid><TextBlock Classes="caption" Text="Folder (use / for subfolders, empty for the top level)" /><DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding SelectedTemplate.IsFavorite}" Content="Favorite" Margin="0,0,0,8" /><AutoCompleteBox x:Name="TemplateFolderInput" ItemsSource="{Binding FolderNames}" Text="{Binding SelectedTemplate.Folder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FilterMode="Contains" MinimumPrefixLength="0" Margin="0,3,8,8" AutomationProperties.Name="Template folder" /></DockPanel><TextBlock Classes="caption" Text="Prompt" /><TextBox x:Name="TemplatePromptInput" Text="{Binding SelectedTemplate.Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="260" AutomationProperties.Name="Template prompt" /><Grid ColumnDefinitions="110,12,190" HorizontalAlignment="Left"><StackPanel><TextBlock Classes="caption" Text="Every seconds" /><TextBox x:Name="TemplateIntervalInput" Text="{Binding SelectedTemplate.IntervalSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Minimum seconds between automatic updates" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="Transcript chars (0 = fill)" /><TextBox x:Name="TemplateCharsInput" Text="{Binding SelectedTemplate.MaxTranscriptChars, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="0 sends as much of the transcript as the model's context window holds (the whole session when it fits). A number sends at most that many characters: the most recent part." AutomationProperties.Name="Maximum transcript characters sent, 0 fills the model's context window" /></StackPanel></Grid><CheckBox IsChecked="{Binding SelectedTemplate.AutoUpdate}" Content="Keep updating as the transcript grows" /><CheckBox IsChecked="{Binding SelectedTemplate.UseTranscript}" Content="Transcript (the most recent part that fits)" /><CheckBox IsChecked="{Binding SelectedTemplate.IncludeTimestamps}" IsEnabled="{Binding SelectedTemplate.UseTranscript}" Content="Timestamps on transcript lines" Margin="24,0,0,0" ToolTip.Tip="Untick to send only 'Speaker: text'. Each line is then about 30 characters shorter, so more of a long session fits." /><CheckBox IsChecked="{Binding SelectedTemplate.UseReferences}" Content="Reference files (below)" /><CheckBox IsChecked="{Binding SelectedTemplate.IncludePrevious}" Content="Previous output" /><CheckBox IsChecked="{Binding SelectedTemplate.UseScreenshot}" Content="Include a screenshot of the table" /><TextBlock Text="Outputs of other templates" Classes="caption" Margin="0,6,0,2" /><ItemsControl ItemsSource="{Binding TemplateInputs}" AutomationProperties.Name="Other templates used as inputs"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" Content="{Binding Template.Name}" ToolTip.Tip="{Binding Hint}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><CheckBox IsChecked="{Binding SelectedTemplate.WriteToFile}" Content="Also write output to a file" /><DockPanel IsEnabled="{Binding SelectedTemplate.WriteToFile}"><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputCommand}" /><TextBox Text="{Binding SelectedTemplate.OutputPath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Template output file path" /></DockPanel><CheckBox IsChecked="{Binding SelectedTemplate.KeepVersions}" Content="Save a versioned copy of each update" ToolTip.Tip="Each changed output is also saved as a timestamped file, next to the output file (in a 'versions' folder) or in the library." /><DockPanel IsEnabled="{Binding SelectedTemplate.KeepVersions}"><Button DockPanel.Dock="Right" Content="Open versions folder" Command="{Binding OpenVersionsCommand}" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Keep only the latest" VerticalAlignment="Center" /><TextBox x:Name="TemplateMaxVersionsInput" Text="{Binding SelectedTemplate.MaxVersions, UpdateSourceTrigger=LostFocus}" Width="80" AutomationProperties.Name="Number of versions to keep, 0 keeps all" /><TextBlock Text="versions (0 = keep all)" VerticalAlignment="Center" Foreground="{StaticResource Dim}" /></StackPanel></DockPanel><WrapPanel><Button Content="▶  Update now" Classes="primary" Command="{Binding RunTemplateCommand}" /><Button Content="■  Stop" Command="{Binding StopTemplateCommand}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Reference files" /><TextBlock Classes="help" Text="Context folder and always-included files shared by all templates." /><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFolderCommand}" /><TextBox Text="{Binding ContextFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Context folder" /></DockPanel><DockPanel><Button DockPanel.Dock="Right" Content="Add files…" Command="{Binding AddPinnedFilesCommand}" /><TextBlock Classes="caption" Text="Always-included files (one path per line)" /></DockPanel><TextBox x:Name="PinnedFilesInput" Text="{Binding PinnedFiles, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60" MaxHeight="140" AutomationProperties.Name="Always-included reference files" /></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Table screenshot" /><TextBlock Classes="help" Text="Pick a virtual tabletop window or whole screen. Templates with Include a screenshot get a fresh image on each update." /><DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCaptureSourcesCommand}" /><ComboBox IsEditable="True" local:EditableComboBox.SyncSelection="True" ItemsSource="{Binding CaptureSources}" Text="{Binding CaptureTarget, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Screen or window to capture" /></DockPanel><WrapPanel><TextBlock Classes="caption" Text="Max width" VerticalAlignment="Center" /><TextBox Width="80" Text="{Binding CaptureMaxWidth, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Maximum screenshot width in pixels" /><Button Content="Test capture" Command="{Binding TestCaptureCommand}" /></WrapPanel><TextBlock Text="{Binding CaptureCaption}" Classes="caption" /><Image Source="{Binding CapturePreview}" MaxHeight="220" Stretch="Uniform" /></StackPanel></Border>
              </StackPanel></ScrollViewer>
              <Border Grid.Column="2" Classes="card"><DockPanel><DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyOutputCommand}" /><local:SectionHeader Text="{Binding SelectedTemplate.Name}" /></DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTemplate.Status}" Classes="caption" AutomationProperties.LiveSetting="Polite" /><TextBox Text="{Binding SelectedTemplate.Output}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Template output" /></DockPanel></Border>
            </Grid>
          </TabItem>

          <TabItem Header="Jobs" Tag="&#xE9D5;">
            <Grid Margin="16,14" RowDefinitions="Auto,*">
              <Border Classes="card"><StackPanel><local:SectionHeader Text="Transcription queue" /><TextBlock Text="{Binding QueueSummary}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" /><WrapPanel><Button Content="Pause transcription" Command="{Binding PauseCommand}" /><Button Content="Resume transcription" Command="{Binding ResumeCommand}" /><Button Content="Cancel transcription jobs" Command="{Binding CancelJobsCommand}" /></WrapPanel><TextBlock Classes="caption" Text="These controls affect transcription for the selected session, not audio capture." /></StackPanel></Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" AutomationProperties.Name="Selected session latest transcription jobs"><DataGrid.Columns><DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" /><DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="160" /><DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="90" /><DataGridTextColumn Header="Error / diagnostic" Binding="{Binding Error}" Width="*" /></DataGrid.Columns></DataGrid>
            </Grid>
          </TabItem>

          <TabItem x:Name="ModelsTab" Header="Privacy / models" Tag="&#xE72E;">
            <ScrollViewer><Grid Margin="16,14,16,6" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
              <StackPanel>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Prerequisites" /><TextBlock Text="{Binding PrerequisiteStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /><WrapPanel><Button Content="Install Visual C++ runtime…" Command="{Binding InstallVcRuntimeCommand}" IsVisible="{Binding VcRuntimeMissing}" /><Button Content="Re-check prerequisites" Command="{Binding RecheckPrerequisitesCommand}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Updates" /><TextBlock Text="{Binding CurrentVersionText}" Classes="help" /><TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" /><CheckBox IsChecked="{Binding AutoUpdate}" Content="Automatically download new releases and install them when the app closes" /><WrapPanel><Button Content="Check for updates now" Command="{Binding CheckForUpdatesCommand}" /><Button Content="{Binding RestartToUpdateLabel}" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding UpdateReady}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Diagnostics and bug reports" /><TextBlock Classes="help" Text="Save diagnostics as a ZIP for bug reports. The ZIP includes logs, update log, Activity panel and system summary, not audio, transcripts, keys or settings." /><TextBlock Text="{Binding LogFolderText}" Classes="caption" TextWrapping="Wrap" /><WrapPanel><Button Content="Save diagnostics ZIP…" Command="{Binding SaveDiagnosticsCommand}" AutomationProperties.Name="Save diagnostics ZIP" /><Button Content="Open log folder" Command="{Binding OpenLogsFolderCommand}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Local Parakeet" /><TextBlock Classes="help" Text="Default local transcription model; downloaded automatically on first start." /><TextBlock Text="{Binding ParakeetStatus}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{Binding SetupStatus}" IsVisible="{Binding HasSetupStatus}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" /><Button Content="Install / repair Parakeet model…" Command="{Binding InstallParakeetModelCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Local Whisper" /><TextBlock Classes="help" Text="Optional local Whisper model using Vulkan when available." /><WrapPanel><Button Content="Install recommended model…" Command="{Binding InstallWhisperModelCommand}" /><Button Content="Choose existing Whisper model…" Command="{Binding ChooseWhisperModelCommand}" /></WrapPanel><TextBlock Text="{Binding LocalModel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /></StackPanel></Border>
                <Border x:Name="ConnectionsCard" Classes="card" DataContext="{Binding Templates}"><StackPanel>
                  <local:SectionHeader Text="Template LLM connections" />
                  <TextBlock Classes="help" Text="Templates use the connection marked Default unless you pick another one on the template. A new connection becomes the default." />
                  <ListBox x:Name="ConnectionList" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" IsVisible="{Binding !HasNoConnection}" MaxHeight="200" Background="{StaticResource InputBg}" AutomationProperties.Name="LLM connections">
                    <ListBox.ItemTemplate><DataTemplate><DockPanel>
                      <Border DockPanel.Dock="Right" Classes="tag" IsVisible="{Binding IsDefault}" ToolTip.Tip="Templates set to Default use this connection."><TextBlock Text="Default" /></Border>
                      <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                    </DockPanel></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="help" IsVisible="{Binding HasNoConnection}" Text="No connection yet. Choose Add connection and pick a service." />
                  <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="AddConnectionButton" Content="+  Add connection  ▾" AutomationProperties.Name="Add connection">
                      <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="NVIDIA Build (hosted, free key)" Command="{Binding AddConnectionCommand}" CommandParameter="NVIDIA Build" />
                        <MenuItem Header="OpenRouter (hosted, API key)" Command="{Binding AddConnectionCommand}" CommandParameter="OpenRouter" />
                        <MenuItem Header="OpenAI (hosted, API key)" Command="{Binding AddConnectionCommand}" CommandParameter="OpenAI" />
                        <Separator />
                        <MenuItem Header="Ollama (this PC or your network)" Command="{Binding AddConnectionCommand}" CommandParameter="Ollama" />
                        <MenuItem Header="LM Studio (this PC)" Command="{Binding AddConnectionCommand}" CommandParameter="LM Studio" />
                        <MenuItem Header="Other OpenAI-compatible server" Command="{Binding AddConnectionCommand}" CommandParameter="Custom (OpenAI-compatible)" />
                      </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button Content="Use as default" Command="{Binding MakeDefaultCommand}" ToolTip.Tip="Templates set to Default use the selected connection." />
                    <Button Content="Remove…" Command="{Binding RemoveConnectionCommand}" />
                  </WrapPanel>
                  <Border Classes="inset" IsVisible="{Binding HasConnection}"><StackPanel>
                    <Grid ColumnDefinitions="*,12,2*"><StackPanel><TextBlock Classes="caption" Text="Name" /><TextBox x:Name="ConnectionNameInput" Text="{Binding SelectedConnection.Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Connection name" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="Base URL" /><TextBox x:Name="ConnectionUrlInput" Text="{Binding SelectedConnection.BaseUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Connection base URL" /></StackPanel></Grid>
                    <TextBlock Classes="caption" Text="Model" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="Load models" Command="{Binding LoadModelsCommand}" /><TextBox x:Name="ConnectionModelInput" Text="{Binding SelectedConnection.Model, UpdateSourceTrigger=PropertyChanged}" Watermark="Type a model name, or choose Load models" AutomationProperties.Name="Model name" /></DockPanel>
                    <ComboBox IsVisible="{Binding HasModels}" ItemsSource="{Binding Models}" SelectedItem="{Binding PickedModel}" PlaceholderText="{Binding ModelPickerText}" MaxDropDownHeight="360" AutomationProperties.Name="Models offered by the server" />
                    <TextBlock Classes="caption" Text="API key" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="Remove key" Click="ClearLlmKeyClick" IsEnabled="{Binding SelectedConnection.HasKey}" /><Button DockPanel.Dock="Right" Content="Save key" Click="SaveLlmKeyClick" /><TextBox x:Name="LlmKeyInput" PasswordChar="●" Watermark="{Binding SelectedConnection.KeyHint}" ToolTip.Tip="{Binding SelectedConnection.KeyStatus}" AutomationProperties.Name="API key for this connection, password input" /></DockPanel>
                    <WrapPanel><Button Content="Test connection" Command="{Binding TestConnectionCommand}" /><Button Content="Check image support" Command="{Binding CheckImageSupportCommand}" /><TextBlock Text="{Binding SelectedConnection.ImageSupportStatus}" Classes="caption" Margin="4,0,0,0" /></WrapPanel>
                    <Grid ColumnDefinitions="*,12,170"><TextBlock Text="{Binding SelectedConnection.ContextStatus}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" /><StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="Token limit (0 = model's)" /><TextBox x:Name="ConnectionContextLimitInput" Text="{Binding SelectedConnection.ContextLimitTokens, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="The most context tokens templates may fill. 0 uses the whole window the server reports. Type a number when the server doesn't report one, or to keep a local model fast and within memory." AutomationProperties.Name="Most context tokens templates may use, 0 uses the model's full window" /></StackPanel></Grid>
                    <TextBlock Text="{Binding ConnectionStatus}" IsVisible="{Binding ConnectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Classes="help" Text="{Binding SelectedConnection.Help}" Margin="0,6,0,0" />
                  </StackPanel></Border>
                </StackPanel></Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Your data, your decision" /><TextBlock Text="{Binding ConsentSummary}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" /><CheckBox IsChecked="{Binding SelectedCloudConsent}" IsEnabled="{Binding HasSession}" Content="I explicitly permit NVIDIA uploads for the selected session." /><WrapPanel><Button Content="Grant selected-session consent" Command="{Binding GrantConsentCommand}" /><Button Content="Revoke cloud consent" Command="{Binding RevokeConsentCommand}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="NVIDIA key" /><TextBlock Text="{Binding KeyStatus}" Classes="help" /><WrapPanel><TextBox x:Name="NvidiaKeyInput" Width="330" PasswordChar="●" AutomationProperties.Name="NVIDIA key, password input, never logged" /><Button Content="Use entered key" Click="SaveKeyClick" /><Button Content="Clear key" Click="ClearKeyClick" /></WrapPanel><CheckBox Content="Remember key (encrypted for your user account)" IsChecked="{Binding RememberKey}" /></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Automatic local speaker analysis" /><TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" FontWeight="SemiBold" /><WrapPanel><Button Content="Install small diarization models…" Command="{Binding InstallModelsCommand}" /><Button Content="Analyze selected session speakers" Command="{Binding DiarizeCommand}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Voice library" /><CheckBox IsChecked="{Binding RememberVoices}" Content="Remember speakers I name and recognize them in future recordings" /><TextBlock Text="{Binding VoiceLibrarySummary}" TextWrapping="Wrap" FontWeight="SemiBold" /><ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberBinding="{Binding Summary}" MinHeight="60" MaxHeight="180" AutomationProperties.Name="Remembered voices" /><WrapPanel><Button Content="Learn from past sessions" Command="{Binding RememberAllVoicesCommand}" /><Button Content="Rename…" Command="{Binding RenameVoiceCommand}" /><Button Content="Forget selected voice" Command="{Binding ForgetVoiceCommand}" /><Button Content="Forget all voices…" Command="{Binding ForgetAllVoicesCommand}" /></WrapPanel></StackPanel></Border>
                <Border Classes="card"><StackPanel><local:SectionHeader Text="Parakeet on the NVIDIA GPU" /><TextBlock Text="{Binding LocalGpuStatus}" TextWrapping="Wrap" FontWeight="SemiBold" /><WrapPanel><Button Content="Use the GPU for Parakeet…" Command="{Binding UseGpuCommand}" /><Button Content="Use the CPU only" Command="{Binding UseCpuCommand}" /></WrapPanel></StackPanel></Border>
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding DataRoot, StringFormat='Local library: {0}'}" Classes="caption" Margin="2,0,0,8" />
            </Grid></ScrollViewer>
          </TabItem>

          <TabItem Header="Discord" Tag="&#xE8BD;">
            <ScrollViewer DataContext="{Binding Discord}" VerticalScrollBarVisibility="Auto">
              <Grid Margin="16,14,16,6" ColumnDefinitions="*,16,*">
                <StackPanel>
                  <Border Classes="card hero"><StackPanel><local:SectionHeader Text="Record a Discord server voice channel" /><TextBlock Classes="help" Text="Your own Discord bot joins a server voice channel and records everyone separately, so transcript lines are named after the Discord user speaking." /><local:SectionHeader Text="1 · Create your Discord app" /><TextBlock Classes="help" Text="{Binding Steps}" /><WrapPanel><Button Content="Open the Discord Developer Portal" Command="{Binding OpenPortalCommand}" /><Button Content="Open my bot's page" Command="{Binding OpenBotPageCommand}" /></WrapPanel><local:SectionHeader Text="2 · Connect the bot" /><WrapPanel><TextBox Width="330" PasswordChar="●" Text="{Binding TokenInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Discord bot token, password input, never logged" /><Button Content="Save and connect" Classes="primary" Command="{Binding ConnectCommand}" /><Button Content="Disconnect" Command="{Binding DisconnectCommand}" /><Button Content="Forget the bot" Command="{Binding ForgetCommand}" /></WrapPanel><TextBlock Text="{Binding BotStatus}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" /><local:SectionHeader Text="3 · Add the bot to your server" /><TextBlock Classes="help" Text="Opens Discord's invite page for your bot with only View Channels and Connect." /><WrapPanel><Button Content="Add the bot to a server" Command="{Binding InviteCommand}" /><Button Content="Copy invite link" Command="{Binding CopyInviteCommand}" /></WrapPanel><TextBlock Text="{Binding InviteUrl}" Classes="caption" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Classes="card"><StackPanel><local:SectionHeader Text="Voice channel" /><DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshChannelsCommand}" /><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" DisplayMemberBinding="{Binding Display}" AutomationProperties.Name="Discord server voice channel" /></DockPanel><WrapPanel><Button Content="●  Join and record" Classes="primary" Command="{Binding JoinAndRecordCommand}" /><Button Content="Join only" Command="{Binding JoinCommand}" /><Button Content="Leave" Command="{Binding LeaveCommand}" /></WrapPanel><TextBlock Text="{Binding VoiceStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Classes="caption" Text="Stop the recording on Record / import. Everyone in the channel sees the bot join; tell people they are recorded and get consent." /></StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Classes="card"><StackPanel><local:SectionHeader Text="Network: firewall, UPnP and port forwarding" /><TextBlock Classes="help" Text="Voice audio arrives over UDP on one fixed port of this PC. It usually works with no setup; if audio does not arrive, work down this list." /><DockPanel><TextBlock Text="Voice UDP port" Classes="caption" VerticalAlignment="Center" /><TextBox Width="90" Text="{Binding VoicePort, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Discord voice UDP port" /></DockPanel><StackPanel IsVisible="{Binding IsWindows}"><local:SectionHeader Text="Firewall" /><Button Content="Allow in Windows Firewall" Command="{Binding FirewallCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding FirewallStatus}" Classes="caption" TextWrapping="Wrap" /><local:SectionHeader Text="UPnP" /><CheckBox Content="Ask the router to forward the voice port (UPnP) each time the bot joins" IsChecked="{Binding UseUpnp}" /><Button Content="Try UPnP now" Command="{Binding UpnpCommand}" HorizontalAlignment="Left" /></StackPanel><TextBlock IsVisible="{Binding !IsWindows}" Classes="help" TextWrapping="Wrap" Text="On Linux, open the voice UDP port above in your firewall if one is active (for example sudo ufw allow PORT/udp, or sudo firewall-cmd --add-port=PORT/udp), and use manual port forwarding below if audio does not arrive." /><TextBlock Text="{Binding NetworkStatus}" Classes="caption" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Classes="card"><StackPanel><local:SectionHeader Text="Manual port forwarding" /><TextBlock Text="{Binding PortForwardSteps}" TextWrapping="Wrap" /><Button Content="Copy port-forwarding steps" Command="{Binding CopyPortForwardCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#110D0B" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid ColumnDefinitions="*,220,Auto">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Grid.Column="1" IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}" Height="8" Margin="15,0" AutomationProperties.Name="Current operation progress" />
        <Button Grid.Column="2" Content="Cancel operation" Command="{Binding CancelOperationCommand}" IsVisible="{Binding Busy}" MinHeight="26" Padding="10,2" Margin="0,2" />
      </Grid>
    </Border>
  </Grid>
</Window>




