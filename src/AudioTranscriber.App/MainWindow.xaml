<Window x:Class="AudioTranscriber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioTranscriber · Local audio library" Width="1440" Height="940"
        MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#172C40" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="AudioTranscriber" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,14,0" />
                    <TextBlock Text="Originals first. Source-language transcripts. Explicit cloud consent." Foreground="#D9E5ED" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </WrapPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding CaptureState}" FontWeight="Bold" Foreground="White" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding RecordingSession}" Foreground="#D9E5ED" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="■  Stop recording" Command="{Binding StopRecordingCommand}"
                        Style="{StaticResource StopButton}" Visibility="{Binding IsRecording, Converter={StaticResource BoolVisibility}}"
                        ToolTip="Stops and seals audio. Does not cancel transcription." />
                <Button Grid.Column="3" Content="{Binding RestartToUpdateLabel}" Command="{Binding RestartToUpdateCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" Visibility="{Binding UpdateReady, Converter={StaticResource BoolVisibility}}"
                        ToolTip="A verified update is downloaded. Closes the app (finishing any recording safely), installs the update, and reopens it. Otherwise it installs the next time you close the app." />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" BorderBrush="#D6E0E8" BorderThickness="1" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Your sessions" Style="{StaticResource Heading}" />
                        <TextBlock Text="Saved locally · newest 2,000 sessions" FontSize="12" Style="{StaticResource Help}" />
                        <Button Content="_Refresh library" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                             BorderThickness="0" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Saved sessions">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:MMM d · HH:mm}}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding State}" FontSize="12" Foreground="{StaticResource Accent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="2,0,0,8">
                    <TextBlock Text="{Binding SelectedSession.Name, TargetNullValue=Make room for a clearer transcript}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SessionSummary}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding SessionError}" Foreground="#A52232" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="#D6E0E8">
                    <TabItem Header="_Record / import">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22">
                                <TextBlock Text="Start with your audio" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Help}" Text="Just press Start recording: the defaults are ready (default output device, your microphone as a separate track, local Whisper, English). It works without cloud consent or a key. Output and microphone are archived as separate tracks; originals survive slow or unavailable transcription." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Session _name" Target="{Binding ElementName=SessionNameInput}" Padding="0" />
                                        <TextBox x:Name="SessionNameInput" Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New session name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Transcription _provider" Target="{Binding ElementName=ProviderInput}" Padding="0" />
                                        <ComboBox x:Name="ProviderInput" ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProvider}" AutomationProperties.Name="New session transcription provider" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Source _language" Target="{Binding ElementName=LanguageInput}" Padding="0" />
                                        <TextBox x:Name="LanguageInput" Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source language" ToolTip="Explicit provider-supported source language; no translation. Examples: local en; Parakeet en-GB; Canary en-US; hosted Whisper en." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ProviderHelp}" Style="{StaticResource Help}" />
                                <TextBlock Text="Language is explicit: use a locale supported by the selected provider (for example, Parakeet en-GB, Canary en-US, Whisper en). Audio is not silently translated." Style="{StaticResource Help}" />
                                <Border Background="#F4F7FA" BorderBrush="#D6E0E8" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding LiveFileEnabled}" AutomationProperties.Name="Mirror new sessions to a live transcript file">
                                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Write the transcript to a live text file (the current recording, or the next recording / import)" />
                                        </CheckBox>
                                        <TextBlock Style="{StaticResource Help}" Text="The file is refreshed every few seconds as transcript lines arrive and is never locked, so VS Code or other apps can keep it open and read it while it is being written. An existing file is overwritten. Treat it as read-only: edits in other apps are overwritten. Use Live file on the Transcript tab to mirror an existing session." />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="_Browse…" Command="{Binding BrowseLiveFileCommand}" />
                                            <TextBox Text="{Binding LiveFilePath, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" AutomationProperties.Name="Live transcript file path" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding LiveFileStatus}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#EDF7F5" BorderBrush="#B8D8D2" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Optional NVIDIA upload — this new session only" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Help}" Text="If enabled, audio from this session's selected output, separate microphone, or imported audio track is sent to the selected NVIDIA-hosted ASR service. NVIDIA terms and service logging apply. Free access has finite, account/model-dependent quotas; it is not unlimited or guaranteed. Send only audio you are permitted to upload, and no personal or confidential data. Already sent audio cannot be recalled." />
                                        <CheckBox IsChecked="{Binding NewCloudConsent}" AutomationProperties.Name="Explicit NVIDIA upload consent for this new session">
                                            <TextBlock TextWrapping="Wrap" Text="I understand these terms and explicitly permit NVIDIA uploads for this new session. (Off by default; reset after creation.)" />
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Visible Windows capture" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Windows _output endpoint" Target="{Binding ElementName=OutputInput}" Padding="0" />
                                        <ComboBox x:Name="OutputInput" ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedItem="{Binding OutputDevice}" AutomationProperties.Name="Selected Windows output device" />
                                        <ProgressBar Value="{Binding OutputLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="12" Margin="0,0,8,0" AutomationProperties.Name="Output capture peak level" />
                                        <TextBlock Text="Output level · active only during recording" FontSize="12" Style="{StaticResource Help}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox Content="Include a separate _microphone track" IsChecked="{Binding MicrophoneEnabled}" Margin="0,0,0,2" />
                                        <ComboBox ItemsSource="{Binding MicrophoneDevices}" DisplayMemberPath="Name" SelectedItem="{Binding MicrophoneDevice}" IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="Optional separate microphone device" />
                                        <CheckBox Content="Reduce _echo from speakers (no headset needed)" IsChecked="{Binding ReduceEcho}" IsEnabled="{Binding MicrophoneEnabled}" Margin="0,4,0,2" ToolTip="Subtracts what the speakers played (the output track) from the microphone before transcription, so remote voices are not transcribed twice. The original microphone audio is kept unchanged." />
                                        <ProgressBar Value="{Binding MicrophoneLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="12" Margin="0,0,8,0" AutomationProperties.Name="Microphone capture peak level" />
                                        <TextBlock Text="Microphone level · not included in loopback. Echo reduction removes speaker audio the mic picks up so it isn't transcribed twice." FontSize="12" Style="{StaticResource Help}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="●  _Start recording" Style="{StaticResource PrimaryButton}" Command="{Binding StartRecordingCommand}" />
                                    <Button Content="■  Stop recording" Style="{StaticResource StopButton}" Command="{Binding StopRecordingCommand}" />
                                    <Button Content="Refresh _devices" Command="{Binding RefreshDevicesCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SetupStatus}" Visibility="{Binding HasSetupStatus, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Stop waits for original tails to seal. Transcription pause/cancel are separate controls in Jobs. Endpoint loss is an error, never a silent switch to a different device." Style="{StaticResource Help}" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}" Padding="10,3" />
                                    <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyActivityCommand}" Padding="10,3" />
                                    <TextBlock Text="Live activity" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Help}" Text="Shows what is happening right now: audio captured, each chunk being transcribed, every new transcript line as it arrives, errors, and live file writes. Recordings are cut into short chunks at pauses, so a line usually appears a few seconds after the speaker pauses; speaker names fill in shortly after." />
                                <ListBox x:Name="ActivityList" ItemsSource="{Binding ActivityLog}" Height="260" Margin="0,0,0,8"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#FBFCFD" BorderBrush="#D6E0E8"
                                         AutomationProperties.Name="Live activity log">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12" Margin="0,1,0,0" />
                                                <TextBlock x:Name="EntryText" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#44515C" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Transcript">
                                                    <Setter TargetName="EntryText" Property="Foreground" Value="#10202E" />
                                                    <Setter TargetName="EntryText" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter TargetName="EntryText" Property="Foreground" Value="#A52232" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Separator Margin="0,8,0,18" />
                                <TextBlock Text="Bring an existing recording" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Help}" Text="Import an audio or audio-bearing video file. FFprobe inspects streams first: a single audio stream is selected automatically; multiple streams require your choice. A managed original is retained and progress appears below. No entire multi-hour recording is loaded into the UI." />
                                <Button Content="_Import audio / video…" Command="{Binding ImportAudioCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="_Transcript">
                        <Grid Margin="12,10">
                            <Grid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="10,4" />
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                </Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                </Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                </Style>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Padding" Value="10,3" />
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" MinHeight="90" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="112" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearSearchCommand}" Margin="0,2,0,2" />
                                <Button DockPanel.Dock="Right" Content="_Find / jump" Command="{Binding SearchCommand}" />
                                <TextBox DockPanel.Dock="Right" Width="86" Text="{Binding Seek, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Jump to transcript timestamp" ToolTip="Jump to a time: seconds, mm:ss or hh:mm:ss">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock DockPanel.Dock="Right" Text="Jump" Margin="6,0,6,0" />
                                <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding SpeakerFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SpeakerFilter}" AutomationProperties.Name="Transcript speaker filter" />
                                <TextBlock DockPanel.Dock="Right" Text="Speaker" Margin="6,0,6,0" />
                                <TextBlock DockPanel.Dock="Left" Text="Search" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search transcript text">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,2,0,4">
                                <Button DockPanel.Dock="Right" Content="_Export…" Command="{Binding ExportCommand}" Margin="0,2,0,2" />
                                <Button DockPanel.Dock="Right" Content="Stop live file" Command="{Binding StopLiveFileCommand}" />
                                <Button DockPanel.Dock="Right" Content="_Live file" Command="{Binding LiveMirrorSelectedCommand}" ToolTip="Continuously mirror this session's transcript to the unlocked live text file chosen on Record / import." />
                                <Button DockPanel.Dock="Right" Content="Analyze speakers" Command="{Binding DiarizeCommand}" ToolTip="Re-checks every line's speaker with the current voice profiles (including voices learned from lines you labeled). Runs locally." />
                                <Button DockPanel.Dock="Right" Content="Next →" Command="{Binding NextPageCommand}" />
                                <Button DockPanel.Dock="Right" Content="← Prev" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                                <TextBlock Text="{Binding PageSummary}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" ToolTip="{Binding PageSummary}" />
                            </DockPanel>
                            <DataGrid x:Name="TranscriptGrid" Grid.Row="2" ItemsSource="{Binding Transcript}" SelectedItem="{Binding SelectedRow}"
                                      SelectionMode="Extended" RowHeight="30" ColumnHeaderHeight="30"
                                      MouseDoubleClick="TranscriptDoubleClick" SelectionChanged="TranscriptSelectionChanged"
                                      PreviewMouseRightButtonDown="TranscriptRightButtonDown" ContextMenuOpening="TranscriptContextMenuOpening"
                                      AutomationProperties.Name="Paged transcript"
                                      AutomationProperties.HelpText="Right-click lines to set or rename the speaker. Ctrl/Shift-click to select several. Double-click plays a line.">
                                <DataGrid.Resources>
                                    <!-- Keep selected lines visibly highlighted while the editor below has focus. -->
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CFE3F7" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#172C40" />
                                </DataGrid.Resources>
                                <DataGrid.ContextMenu>
                                    <ContextMenu AutomationProperties.Name="Transcript line actions" />
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="76" />
                                    <DataGridTextColumn Header="Track" Binding="{Binding TrackName}" Width="90" />
                                    <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="120" />
                                    <DataGridTextColumn Header="Transcript" Binding="{Binding Text}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="Timing" Binding="{Binding Timing}" Width="76" />
                                    <DataGridTextColumn Header="Attribution" Binding="{Binding Attribution}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Focusable="False"
                                          ToolTip="Drag to resize the transcript and the line editor" />
                            <TabControl Grid.Row="4">
                                <TabItem Header="Selected line" x:Name="SelectedLineTab">
                                    <Grid Margin="8,6">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="■ Stop" Command="{Binding StopPlaybackCommand}" ToolTip="Stop playback" Margin="0,2,0,2" />
                                            <Button DockPanel.Dock="Right" Content="▶ Play" Command="{Binding PlayRowCommand}" ToolTip="Play this line from its own track" />
                                            <Button DockPanel.Dock="Right" Content="Restore raw" Command="{Binding RestoreRawCommand}" ToolTip="Drop your correction and show the recognized text again" />
                                            <Button DockPanel.Dock="Right" Content="Save text" Command="{Binding SaveCorrectionCommand}" ToolTip="Save the corrected text (left box). The recognized text (right box) is kept." />
                                            <TextBlock Text="{Binding SelectionSummary}" Margin="0,0,6,0" ToolTip="{Binding RowDetails}" />
                                            <ComboBox Width="180" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding SpeakerNames}"
                                                      Text="{Binding LineSpeaker, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker for selected lines"
                                                      ToolTip="Pick a speaker or type a new name, then press Enter or Set speaker">
                                                <ComboBox.InputBindings><KeyBinding Key="Return" Command="{Binding SetLineSpeakerCommand}" /></ComboBox.InputBindings>
                                            </ComboBox>
                                            <Button Content="Set speaker" Command="{Binding SetLineSpeakerCommand}" HorizontalAlignment="Left"
                                                    ToolTip="Label the selected line(s). The app learns this voice and re-checks lines that are still Unknown." />
                                        </DockPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Correction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top" AutomationProperties.Name="Editable transcript correction" x:Name="CorrectionInput"
                                                     ToolTip="Edit the line's text here, then Save text" />
                                            <TextBox Grid.Column="1" Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top" Background="#F3F6F9" AutomationProperties.Name="Preserved raw recognition" ToolTip="{Binding RowDetails}" Margin="0,2,0,2" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Speaker names">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8,6">
                                            <TextBlock Text="Rename a speaker on every line. Giving two speakers the same name merges them: their voice samples combine so future lines match better." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <WrapPanel>
                                                <ComboBox Width="190" ItemsSource="{Binding Speakers}" SelectedItem="{Binding ManagedSpeaker}" DisplayMemberPath="Name" AutomationProperties.Name="Speaker to rename" />
                                                <TextBox Width="220" Text="{Binding SpeakerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker display name">
                                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RenameSpeakerCommand}" /></TextBox.InputBindings>
                                                </TextBox>
                                                <Button Content="Rename throughout session" Command="{Binding RenameSpeakerCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Track playback">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8,6">
                                            <TextBlock Text="Play one original track from a time. Unlinked VTT tracks have no audio." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <WrapPanel>
                                                <ComboBox Width="260" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="Name" AutomationProperties.Name="Original track to play" />
                                                <TextBox Width="140" Text="{Binding PlaybackTimestamp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Original track playback timestamp" />
                                                <Button Content="▶ Play track" Command="{Binding PlayTrackCommand}" />
                                                <Button Content="■ Stop playback" Command="{Binding StopPlaybackCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>
                    <TabItem Header="_Jobs">
                        <Grid Margin="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding QueueSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                <Button Content="_Pause transcription" Command="{Binding PauseCommand}" />
                                <Button Content="_Resume transcription" Command="{Binding ResumeCommand}" />
                                <Button Content="_Cancel transcription jobs" Command="{Binding CancelJobsCommand}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="2" Style="{StaticResource Help}" Text="These controls affect transcription for the selected session, NOT audio capture. Recording Stop remains visible at the top. Latest 100 jobs below; aggregate counts include all jobs. Authentication, quota, and consent failures need explicit action, never a provider fallback." />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding Jobs}" AutomationProperties.Name="Selected session latest transcription jobs">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
                                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="160" />
                                    <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="80" />
                                    <DataGridTextColumn Header="Error / diagnostic" Binding="{Binding Error}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="_Privacy / models">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22">
                                <TextBlock Text="Prerequisites" Style="{StaticResource Heading}" />
                                <TextBlock Text="{Binding PrerequisiteStatus}" TextWrapping="Wrap" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding PrerequisitesReady}" Value="False"><Setter Property="Foreground" Value="#A52232" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Help}" Text="FFmpeg and FFprobe ship in the release's ffmpeg folder (LGPL build); an FFmpeg on PATH or installed with WinGet is also found. Local Whisper needs Microsoft's Visual C++ 2015-2022 runtime (x64); if it is missing, the app runs Microsoft's installer on startup (approve the Windows prompt)." />
                                <WrapPanel>
                                    <Button Content="Install Visual C++ runtime…" Command="{Binding InstallVcRuntimeCommand}" Visibility="{Binding VcRuntimeMissing, Converter={StaticResource BoolVisibility}}" />
                                    <Button Content="Re-check prerequisites" Command="{Binding RecheckPrerequisitesCommand}" />
                                </WrapPanel>
                                <Separator Margin="0,8,0,16" />
                                <TextBlock Text="Updates" Style="{StaticResource Heading}" />
                                <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Help}" />
                                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                <CheckBox IsChecked="{Binding AutoUpdate}" Content="Automatically download new releases and install them when the app closes" />
                                <WrapPanel>
                                    <Button Content="Check for updates now" Command="{Binding CheckForUpdatesCommand}" />
                                    <Button Content="{Binding RestartToUpdateLabel}" Command="{Binding RestartToUpdateCommand}" Visibility="{Binding UpdateReady, Converter={StaticResource BoolVisibility}}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Help}" Text="Updates are the Windows ZIP from the latest GitHub release, verified against its published SHA-256 before use. They replace only the application folder; your library, recordings, settings, and models are untouched. Nothing installs while the app is running." />
                                <Separator Margin="0,8,0,16" />
                                <TextBlock Text="Your data, your decision" Style="{StaticResource Heading}" />
                                <TextBlock Text="{Binding ConsentSummary}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Help}" Text="Consent applies only to the selected session's configured NVIDIA provider and audio tracks. NVIDIA service terms/logging and finite account/model quotas apply. Upload only permitted audio, with no personal or confidential data. Revocation stops future uploads, but cannot recall already sent audio. Choosing local Whisper never opts into cloud on an error." />
                                <CheckBox IsChecked="{Binding SelectedCloudConsent}" IsEnabled="{Binding HasSession}">
                                    <TextBlock Text="I explicitly permit NVIDIA uploads for the selected session under the disclosure above." TextWrapping="Wrap" />
                                </CheckBox>
                                <WrapPanel>
                                    <Button Content="Grant selected-session consent" Command="{Binding GrantConsentCommand}" />
                                    <Button Content="Revoke cloud consent" Command="{Binding RevokeConsentCommand}" />
                                </WrapPanel>
                                <Separator Margin="0,12" />
                                <TextBlock Text="NVIDIA key — never required to record" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Help}" />
                                <WrapPanel>
                                    <PasswordBox x:Name="NvidiaKeyInput" Width="330" Padding="8" Margin="0,4,10,4" AutomationProperties.Name="NVIDIA key, password input, never logged" />
                                    <Button Content="Use entered key" Click="SaveKeyClick" />
                                    <Button Content="Clear key" Click="ClearKeyClick" />
                                </WrapPanel>
                                <CheckBox Content="Remember key with Windows current-user DPAPI (off by default)" IsChecked="{Binding RememberKey}" />
                                <TextBlock Text="Memory-only by default. The password field is cleared after use. No keys in configuration, logs, command-line arguments, transcripts, or exports. Graph authentication is separate." Style="{StaticResource Help}" />
                                <Separator Margin="0,8,0,16" />
                                <TextBlock Text="Automatic local speaker analysis" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Help}" Text="About 33.49 MB total, downloaded automatically on first start so speakers are labeled by default. Segmentation is MIT (CNRS 2023); embedding is CC BY 4.0 with retained attribution and package notices. Official release artifacts need no Hugging Face token. Use the button below to retry if the automatic download failed." />
                                <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <WrapPanel>
                                    <Button Content="Install small diarization models…" Command="{Binding InstallModelsCommand}" />
                                    <Button Content="Analyze selected session speakers" Command="{Binding DiarizeCommand}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Help}" Text="Automatic labels are not verified participant identities. Short turns, overlap, changing character voices, and crowded windows can remain uncertain. More session speakers are possible, but the segmentation model has local-window limits. Manual rename and assignment are available in Transcript." />
                                <Separator Margin="0,8,0,16" />
                                <TextBlock Text="Local Whisper" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Help}" Text="Default: Whisper large-v3-turbo (about 1.51 GiB, MIT), downloaded and SHA256-verified automatically on first start. You can record while it downloads; queued audio is transcribed as soon as it is ready. It runs on your GPU through Vulkan when a GPU driver is present (NVIDIA, AMD, or Intel), otherwise on the CPU. The runtime used is shown in the status bar after each chunk. Whisper transcribes all voices but does not label speakers; speaker analysis above does that." />
                                <TextBlock Text="{Binding SetupStatus}" Visibility="{Binding HasSetupStatus, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="Install recommended model (large-v3-turbo)…" Command="{Binding InstallWhisperModelCommand}" />
                                    <Button Content="Choose existing Whisper model…" Command="{Binding ChooseWhisperModelCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding LocalModel}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DataRoot, StringFormat=Local library: {0}}" Style="{StaticResource Help}" Margin="0,24,0,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="_VTT / Teams">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22">
                                <TextBlock Text="Transcript sources with provenance" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Help}" Text="First select an existing session. Import a local WebVTT file to add timed cues and source speaker labels. Cue times retain the source transcript clock; they are not automatically aligned to this session's audio. Labels are retained as transcript provenance, not inferred verified identities. An unlinked transcript does not manufacture playable audio." />
                                <Button Content="Import local .vtt into selected session…" Command="{Binding ImportVttCommand}" HorizontalAlignment="Left" />
                                <Separator Margin="0,18" />
                                <TextBlock Text="Microsoft Teams · configuration required" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Help}" Text="This uses real delegated Microsoft Graph retrieval of an existing meeting transcript—not live Teams audio. Supply a work/school tenant, public-client app ID configured for device-code sign-in, and explicit user, online-meeting, and transcript IDs. OnlineMeetingTranscript.Read.All permission, meeting access, and tenant policy must permit retrieval." />
                                <Button Content="Fetch configured Teams transcript…" Command="{Binding FetchTeamsCommand}" HorizontalAlignment="Left" />
                                <TextBlock Style="{StaticResource Help}" Text="The sign-in window displays the actual Microsoft verification URL, device code, and expiration—not tokens. Attribution restrictions are respected; an explicitly permitted unattributed policy option is available. No tenant or live Graph validation is implied by the UI smoke test." />
                                <Separator Margin="0,18" />
                                <TextBlock Text="Not included: live Teams or Discord audio" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Help}" Text="Live Teams requires a separately deployed Azure media bot and tenant policy. Discord live receive needs a visible, authorized guild bot and validated DAVE-compatible receive support. Neither is represented by a fake capture button. Windows selected-output capture is a distinct, explicit local action." />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#D6E0E8" BorderThickness="0,1,0,0" Background="White" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="#A52232" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Height="8" Margin="15,0" AutomationProperties.Name="Current operation progress" />
                <Button Grid.Column="2" Content="Cancel operation" Command="{Binding CancelOperationCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" ToolTip="Cancels the current import, download, or analysis. Does not stop an active recording." />
            </Grid>
        </Border>
    </Grid>
</Window>
