<Window x:Class="AudioTranscriber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioTranscriber.App"
        Title="AudioTranscriber · Local audio library" Width="1440" Height="940"
        MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <!-- The custom title bar replaces both the Windows caption and the old banner. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="RecordingPill" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Pill" Height="26" CornerRadius="13" Padding="10,0,12,0" Margin="0,0,8,0" BorderThickness="1"
                                BorderBrush="{StaticResource Line}" Background="#120E0B" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="Transparent" Stroke="{StaticResource Dim}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="State" Text="{Binding CaptureState}" Margin="8,0,0,0" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource Dim}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="Session" Text="{Binding RecordingSession}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                           MaxWidth="200" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2A1110" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#8C2B24" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CrimsonBright}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource CrimsonBright}" />
                                <Setter TargetName="State" Property="Foreground" Value="#FF9B90" />
                                <Setter TargetName="Session" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                             Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stopping}" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource GoldDeep}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Gold}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Gold}" />
                                <Setter TargetName="State" Property="Foreground" Value="{StaticResource GoldBright}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickRecordButton" TargetType="Button" BasedOn="{StaticResource RecordButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SessionErrorBar" TargetType="Border">
            <Setter Property="Background" Value="#2A1311" />
            <Setter Property="BorderBrush" Value="#6E2620" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SessionError}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SessionError}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: brand, selected session, recording state and controls, window buttons. -->
        <Border Background="{StaticResource TitleBarFill}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Dock order keeps the window buttons, then the recording controls, visible at the narrowest width. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseClick" ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ContentControl Style="{StaticResource RecordingPill}"
                                    ToolTip="Recording state. Stop seals the original audio; it does not cancel transcription. This stays here on every tab." />
                    <Button Content="●  Record" Command="{Binding StartRecordingCommand}" Style="{StaticResource QuickRecordButton}"
                            MinHeight="28" Padding="12,2" Margin="0,0,8,0" AutomationProperties.Name="Quick start recording"
                            ToolTip="Start a new recording now with the settings on Record / import (defaults work as-is)." />
                    <Button Content="■  Stop recording" Command="{Binding StopRecordingCommand}" Style="{StaticResource StopButton}"
                            MinHeight="28" Padding="12,2" Margin="0,0,8,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolVisibility}}"
                            ToolTip="Stops and seals audio. Does not cancel transcription." />
                    <Button Content="{Binding RestartToUpdateLabel}" Command="{Binding RestartToUpdateCommand}" Style="{StaticResource PrimaryButton}"
                            MinHeight="28" Padding="12,2" Margin="0,0,8,0" Visibility="{Binding UpdateReady, Converter={StaticResource BoolVisibility}}"
                            ToolTip="A verified update is downloaded. Closes the app (finishing any recording safely), installs the update, and reopens it. Otherwise it installs the next time you close the app." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <!-- The app icon's waveform bars and transcript lines (scripts\New-AppIcon.ps1 geometry), without its tile. -->
                    <Viewbox Height="22" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="AudioTranscriber logo">
                        <Canvas Width="158" Height="140">
                            <Canvas.Resources>
                                <LinearGradientBrush x:Key="LogoBar" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFE39A" Offset="0" />
                                    <GradientStop Color="#C9962F" Offset="1" />
                                </LinearGradientBrush>
                                <SolidColorBrush x:Key="LogoLine" Color="#F6EAD2" />
                            </Canvas.Resources>
                            <Rectangle Canvas.Left="0" Canvas.Top="40" Width="20" Height="60" RadiusX="10" RadiusY="10" Fill="{StaticResource LogoBar}" />
                            <Rectangle Canvas.Left="30" Canvas.Top="0" Width="20" Height="140" RadiusX="10" RadiusY="10" Fill="{StaticResource LogoBar}" />
                            <Rectangle Canvas.Left="60" Canvas.Top="24" Width="20" Height="92" RadiusX="10" RadiusY="10" Fill="{StaticResource LogoBar}" />
                            <Rectangle Canvas.Left="96" Canvas.Top="25" Width="62" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource LogoLine}" />
                            <Rectangle Canvas.Left="96" Canvas.Top="61" Width="62" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource LogoLine}" />
                            <Rectangle Canvas.Left="96" Canvas.Top="97" Width="36" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource LogoLine}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="AudioTranscriber" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                               Typography.Capitals="SmallCaps" Foreground="{StaticResource GoldBright}" />
                </StackPanel>
                <DockPanel Margin="16,0,12,0" VerticalAlignment="Center">
                    <Border DockPanel.Dock="Left" Width="1" Height="18" Background="{StaticResource Line}" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Left" MaxWidth="420" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedSession.Name, TargetNullValue=No session selected, FallbackValue=No session selected}" />
                    <TextBlock Text="{Binding SessionSummary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,1,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="200" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Session library -->
            <Border Background="{StaticResource SidebarFill}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,8,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="6,0,0,0"
                                ToolTip="Refresh library" AutomationProperties.Name="Refresh library">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <AccessText Text="_Refresh" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding DeleteSessionsCommand}" Margin="6,0,0,0"
                                ToolTip="Delete sessions… (pick old sessions to remove with their audio)" AutomationProperties.Name="Delete sessions">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding MergeSessionsCommand}" Margin="6,0,0,0"
                                ToolTip="Merge sessions… (stitch a recording that was split into several sessions back into one)" AutomationProperties.Name="Merge sessions">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="12" />
                        </Button>
                        <ContentControl Style="{StaticResource SectionHeader}" Content="Your sessions" Margin="0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Shift-click for several · right-click for actions" Style="{StaticResource Caption}" Margin="14,2,14,8" TextTrimming="CharacterEllipsis"
                               ToolTip="Shows the newest 2,000 sessions. Shift-click selects a range and Ctrl-click adds or removes one; right-click the selection to merge or delete it (Delete also works). The trash button removes several old ones at once." />
                    <ListBox x:Name="SessionList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionMode="Extended"
                             BorderThickness="0" Margin="6,0,6,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseRightButtonDown="SessionListRightButtonDown" ContextMenuOpening="SessionListContextMenuOpening"
                             KeyDown="SessionListKeyDown" SelectionChanged="SessionListSelectionChanged"
                             AutomationProperties.Name="Saved sessions"
                             AutomationProperties.HelpText="Shift-click or Ctrl-click to select several sessions. Right-click the selection, or press Delete, to merge or delete it. The trash button deletes several old sessions at once.">
                        <ListBox.ContextMenu>
                            <ContextMenu AutomationProperties.Name="Session actions" />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11.5" Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:MMM d · HH:mm}}" Foreground="{StaticResource Dim}" FontSize="12" />
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" Background="{StaticResource Line}" BorderBrush="#0D0A08" BorderThickness="2,0" ToolTip="Drag to resize the session list" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SessionErrorBar}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource ErrorText}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SessionError}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabItem Header="_Record / import" Tag="&#xE720;">
                        <Grid Margin="16,14,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="420" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" MinWidth="280" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource HeroCard}">
                                    <StackPanel>
                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Start with your audio" />
                                        <TextBlock Style="{StaticResource Help}" Text="Just press Start recording: the defaults are ready (default output device, your microphone as a separate track, local Parakeet, English). It works without cloud consent or a key. Output and microphone are archived as separate tracks; originals survive slow or unavailable transcription." />
                                        <WrapPanel>
                                            <Button Content="●  _Start recording" Style="{StaticResource PrimaryButton}" Command="{Binding StartRecordingCommand}"
                                                    ToolTip="Starts a new session with the settings below." />
                                            <Button Content="{Binding ContinueRecordingLabel}" Command="{Binding ContinueRecordingCommand}"
                                                    ToolTip="Records more into the session selected on the left instead of starting a new one: new audio and text follow what it already has (for example after restarting the app). Uses that session's provider and language, and the devices below." />
                                            <Button Content="■  Stop recording" Style="{StaticResource StopButton}" Command="{Binding StopRecordingCommand}" />
                                            <Button Content="_Import audio / video…" Command="{Binding ImportAudioCommand}"
                                                    ToolTip="Bring an existing recording: an audio or audio-bearing video file. FFprobe inspects streams first: a single audio stream is selected automatically; multiple streams require your choice. A managed original is retained and progress appears in the status bar. No entire multi-hour recording is loaded into the UI." />
                                            <Button Content="Refresh _devices" Command="{Binding RefreshDevicesCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SetupStatus}" Visibility="{Binding HasSetupStatus, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Stop waits for original tails to seal. Transcription pause/cancel are separate controls in Jobs. Endpoint loss is an error, never a silent switch to a different device. Importing uses the same new-session settings below." />
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,6,0">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <ContentControl Style="{StaticResource SectionHeader}" Content="New session" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Label Content="Session _name" Target="{Binding ElementName=SessionNameInput}" />
                                                        <TextBox x:Name="SessionNameInput" Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New session name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <Label Content="Transcription _provider" Target="{Binding ElementName=ProviderInput}" />
                                                        <ComboBox x:Name="ProviderInput" ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProvider}" AutomationProperties.Name="New session transcription provider" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Label Content="Source _language" Target="{Binding ElementName=LanguageInput}" />
                                                        <TextBox x:Name="LanguageInput" Margin="0,3,0,8" Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source language" ToolTip="Explicit provider-supported source language; no translation. Examples: local Parakeet en, de, fr…; local Whisper any ISO code; hosted Parakeet en-GB; Canary en-US; hosted Whisper en." />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding ProviderHelp}" Style="{StaticResource Help}" />
                                                <TextBlock Text="Language is explicit: use a locale supported by the selected provider (for example, Parakeet en-GB, Canary en-US, Whisper en). Audio is not silently translated." Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <ContentControl Style="{StaticResource SectionHeader}" Content="Visible Windows capture" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Label Content="Windows _output endpoint" Target="{Binding ElementName=OutputInput}" />
                                                        <ComboBox x:Name="OutputInput" Margin="0,3,0,8" ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedItem="{Binding OutputDevice}" AutomationProperties.Name="Selected Windows output device" />
                                                        <ProgressBar Value="{Binding OutputLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="10" AutomationProperties.Name="Output capture peak level" />
                                                        <TextBlock Text="Output level · active only during recording" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                                        <Label Content="_Pause that ends a phrase" Target="{Binding ElementName=PhrasePauseInput}" Margin="0,8,0,0" />
                                                        <DockPanel Margin="0,3,0,0">
                                                            <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PhrasePauseMilliseconds, StringFormat={}{0} ms}" />
                                                            <Slider x:Name="PhrasePauseInput" Minimum="200" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="500"
                                                                    Value="{Binding PhrasePauseMilliseconds}" VerticalAlignment="Center"
                                                                    AutomationProperties.Name="Silence in milliseconds that ends a live transcript phrase"
                                                                    ToolTip="How long the speaker must be silent before live audio is cut into a new phrase for transcription. Raise it if lines are split into too many short pieces; lower it for faster live text. Applies to the next recording." />
                                                        </DockPanel>
                                                        <TextBlock Text="Longer pauses give fewer, longer lines; shorter pauses give faster live text." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <CheckBox Content="Include a separate _microphone track" IsChecked="{Binding MicrophoneEnabled}" Margin="0,0,0,2" />
                                                        <ComboBox Margin="0,3,0,4" ItemsSource="{Binding MicrophoneDevices}" DisplayMemberPath="Name" SelectedItem="{Binding MicrophoneDevice}" IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="Optional separate microphone device" />
                                                        <CheckBox Content="Reduce _echo from speakers (no headset needed)" IsChecked="{Binding ReduceEcho}" IsEnabled="{Binding MicrophoneEnabled}" Margin="0,4,0,8" ToolTip="Subtracts what the speakers played (the output track) from the microphone before transcription, so remote voices are not transcribed twice. The original microphone audio is kept unchanged." />
                                                        <Label Content="Label microphone lines _as" Target="{Binding ElementName=MicrophoneNameInput}" IsEnabled="{Binding MicrophoneEnabled}" />
                                                        <TextBox x:Name="MicrophoneNameInput" Text="{Binding MicrophoneName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding MicrophoneEnabled}" Margin="0,3,0,8"
                                                                 AutomationProperties.Name="Speaker name for microphone lines"
                                                                 ToolTip="Your name, for example. Every microphone line of new recordings gets this speaker automatically. Leave empty to show 'Me (mic)'. For an existing session, right-click it → Name all microphone lines." />
                                                        <ProgressBar Value="{Binding MicrophoneLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="10" AutomationProperties.Name="Microphone capture peak level" />
                                                        <TextBlock Text="Microphone level · not included in loopback. Echo reduction removes speaker audio the mic picks up so it isn't transcribed twice." Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <ContentControl Style="{StaticResource SectionHeader}" Content="Live transcript file" />
                                                <CheckBox IsChecked="{Binding LiveFileEnabled}" AutomationProperties.Name="Mirror new sessions to a live transcript file">
                                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Write the transcript to a live text file (the current recording, or the next recording / import)" />
                                                </CheckBox>
                                                <TextBlock Style="{StaticResource Help}" Text="The file is refreshed every few seconds as transcript lines arrive and is never locked, so VS Code or other apps can keep it open and read it while it is being written. An existing file is overwritten. Treat it as read-only: edits in other apps are overwritten. Use Live file on the Transcript tab to mirror an existing session." />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="_Browse…" Command="{Binding BrowseLiveFileCommand}" Margin="0,3,0,8" />
                                                    <TextBox Text="{Binding LiveFilePath, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" AutomationProperties.Name="Live transcript file path" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding LiveFileStatus}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource WarningCard}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE753;" Foreground="#F2A195" FontSize="15" Margin="0,0,10,0" />
                                                    <TextBlock Text="Optional NVIDIA upload — this new session only" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="#F2B3A8" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Help}" Text="If enabled, audio from this session's selected output, separate microphone, or imported audio track is sent to the selected NVIDIA-hosted ASR service. With local Whisper selected, only the chunks Whisper is unsure about are sent, to hosted Parakeet, and only when local Parakeet isn't installed (English sessions, NVIDIA key required); everything else stays on this PC. Local Parakeet sessions never upload. NVIDIA terms and service logging apply. Free access has finite, account/model-dependent quotas; it is not unlimited or guaranteed. Send only audio you are permitted to upload, and no personal or confidential data. Already sent audio cannot be recalled." />
                                                <CheckBox IsChecked="{Binding NewCloudConsent}" AutomationProperties.Name="Explicit NVIDIA upload consent for this new session">
                                                    <TextBlock TextWrapping="Wrap" Text="I understand these terms and explicitly permit NVIDIA uploads for this new session. (Off by default; reset after creation.)" />
                                                </CheckBox>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}" Padding="10,3" MinHeight="28" Margin="0,0,0,6" />
                                        <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyActivityCommand}" Padding="10,3" MinHeight="28" Margin="0,0,6,6" />
                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Live activity" Margin="0,0,12,6" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,10" Text="Shows what is happening right now: audio captured, each chunk being transcribed, every new transcript line as it arrives, errors, and live file writes. Recordings are cut into short chunks at pauses, so a line usually appears a few seconds after the speaker pauses; speaker names fill in shortly after." />
                                    <ListBox x:Name="ActivityList" ItemsSource="{Binding ActivityLog}" MinHeight="160"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource InputBg}"
                                             AutomationProperties.Name="Live activity log">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Dim}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <TextBlock x:Name="EntryText" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Transcript">
                                                        <Setter TargetName="EntryText" Property="Foreground" Value="{StaticResource Ink}" />
                                                        <Setter TargetName="EntryText" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                        <Setter TargetName="EntryText" Property="Foreground" Value="{StaticResource ErrorText}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Disc_ord" Tag="&#xE8BD;">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Discord}">
                            <Grid Margin="16,14,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource HeroCard}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Record a Discord server voice channel" />
                                            <TextBlock Style="{StaticResource Help}" Text="Your own Discord bot joins a voice channel in a server and records everyone in it. Discord sends each person's voice separately, so every transcript line is named after the Discord user who said it, and their voice prints are learned under that name (with speaker models installed and Remember voices on). Bots can't join DM or group-DM calls; for those, record Windows output instead." />
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="1 · Create your Discord app" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Help}" Text="{Binding Steps}" />
                                            <WrapPanel>
                                                <Button Content="Open the Discord Developer Portal" Command="{Binding OpenPortalCommand}"
                                                        ToolTip="https://discord.com/developers/applications — choose New Application there." />
                                                <Button Content="Open my bot's page" Command="{Binding OpenBotPageCommand}" ToolTip="Where you reset and copy the bot token." />
                                            </WrapPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="2 · Connect the bot" Margin="0,8,0,0" />
                                            <WrapPanel>
                                                <PasswordBox x:Name="DiscordTokenInput" Width="330" Padding="8" Margin="0,4,10,4" PasswordChanged="DiscordTokenChanged"
                                                             AutomationProperties.Name="Discord bot token, password input, never logged" />
                                                <Button Content="Save and connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}"
                                                        ToolTip="Saves the token encrypted for your Windows account (discord.json in the library) and connects. With a saved token, leave the box empty to reconnect." />
                                                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                                                <Button Content="Forget the bot" Command="{Binding ForgetCommand}" ToolTip="Disconnects and deletes the saved token from this PC." />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding BotStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="3 · Add the bot to your server" Margin="0,10,0,0" />
                                            <TextBlock Style="{StaticResource Help}" Text="Opens Discord's invite page for your bot with only View Channels and Connect. You need Manage Server in that server; otherwise send the link to someone who has it." />
                                            <WrapPanel>
                                                <Button Content="Add the bot to a server" Command="{Binding InviteCommand}" />
                                                <Button Content="Copy invite link" Command="{Binding CopyInviteCommand}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding InviteUrl}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="4 · Join a voice channel and record" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshChannelsCommand}" Margin="8,3,0,8" />
                                                <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" DisplayMemberPath="Display" Margin="0,3,0,8"
                                                          AutomationProperties.Name="Discord server voice channel" />
                                            </DockPanel>
                                            <WrapPanel>
                                                <Button Content="●  Join and record" Style="{StaticResource PrimaryButton}" Command="{Binding JoinAndRecordCommand}"
                                                        ToolTip="Joins the channel and starts a new session with the settings on Record / import (no microphone track: Discord already carries everyone, including you)." />
                                                <Button Content="Join only" Command="{Binding JoinCommand}"
                                                        ToolTip="Joins without recording. The channel then appears as an output choice on Record / import, so you can also Continue recording an existing session." />
                                                <Button Content="Leave" Command="{Binding LeaveCommand}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding VoiceStatus}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Stop the recording on Record / import. Everyone in the channel sees the bot join; tell people they are recorded and get their consent. Audio is end-to-end encrypted by Discord (DAVE) and decrypted only on this PC; transcription follows the session's provider." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Network: firewall, UPnP and port forwarding" />
                                            <TextBlock Style="{StaticResource Help}" Text="Voice audio arrives over UDP on one fixed port of this PC. It usually works with no setup, because the bot connects out to Discord first. If the status says people are talking but no audio arrives, work down this list." />
                                            <DockPanel Margin="0,4,0,0">
                                                <Label Content="Voice UDP port" Target="{Binding ElementName=DiscordPortInput}" VerticalAlignment="Center" />
                                                <TextBox x:Name="DiscordPortInput" Width="90" HorizontalAlignment="Left" Margin="8,3,0,8" Text="{Binding VoicePort, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Discord voice UDP port" ToolTip="1024–65535. Applies to the next join." />
                                            </DockPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="a · Windows Firewall" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource Help}" Text="Adds an inbound rule allowing this app on the voice port (UDP, all network types). Windows asks for administrator approval once." />
                                            <Button Content="Allow in Windows Firewall" Command="{Binding FirewallCommand}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding FirewallStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="b · UPnP (automatic router forwarding)" Margin="0,8,0,0" />
                                            <CheckBox Content="Ask the router to forward the voice port (UPnP) each time the bot joins" IsChecked="{Binding UseUpnp}" />
                                            <Button Content="Try UPnP now" Command="{Binding UpnpCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="c · Forward the port by hand" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Help}" Text="{Binding PortForwardSteps}" />
                                            <Button Content="Copy these steps" Command="{Binding CopyPortForwardCommand}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_Transcript" Tag="&#xE8A5;">
                        <Grid Margin="12,10">
                            <Grid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="10,4" />
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                </Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                </Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                </Style>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Padding" Value="10,5" />
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" MinHeight="90" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="112" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearSearchCommand}" Margin="0,2,0,2" />
                                <Button DockPanel.Dock="Right" Content="_Find / jump" Command="{Binding SearchCommand}" />
                                <TextBox DockPanel.Dock="Right" Width="86" Text="{Binding Seek, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Jump to transcript timestamp" ToolTip="Jump to a time: seconds, mm:ss or hh:mm:ss">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock DockPanel.Dock="Right" Text="Jump" Foreground="{StaticResource Muted}" Margin="6,0,6,0" />
                                <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding SpeakerFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SpeakerFilter}" AutomationProperties.Name="Transcript speaker filter" />
                                <TextBlock DockPanel.Dock="Right" Text="Speaker" Foreground="{StaticResource Muted}" Margin="6,0,6,0" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{StaticResource Gold}" Margin="2,0,8,0" ToolTip="Search" />
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search transcript text" ToolTip="Search transcript text, then press Enter or Find / jump">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,2,0,6">
                                <Button DockPanel.Dock="Right" Content="_Export…" Command="{Binding ExportCommand}" Margin="0,2,0,2" />
                                <Button DockPanel.Dock="Right" Content="Stop live file" Command="{Binding StopLiveFileCommand}" />
                                <Button DockPanel.Dock="Right" Content="_Live file" Command="{Binding LiveMirrorSelectedCommand}" ToolTip="Continuously mirror this session's transcript to the unlocked live text file chosen on Record / import." />
                                <Button DockPanel.Dock="Right" Content="Re-transcribe…" Command="{Binding ResplitCommand}"
                                        ToolTip="Cuts this session's audio again into phrases using the current 'Pause that ends a phrase' setting (Record / import) and transcribes it from scratch, then re-runs speaker analysis. Speakers you set by hand carry over; text edits are discarded. Afterwards press Fill speakers from my labels." />
                                <Button DockPanel.Dock="Right" Content="Analyze speakers" Command="{Binding DiarizeCommand}" ToolTip="Re-checks every line's speaker with the current voice profiles (including voices learned from lines you labeled). Runs locally." />
                                <Button DockPanel.Dock="Right" Content="Fill speakers from my labels" Command="{Binding FillSpeakersCommand}" Style="{StaticResource PrimaryButton}"
                                        ToolTip="Label a few lines for each person first (right-click → Set speaker), then press this: every other line in the whole recording gets the labeled person whose voice it sounds closest to. Lines you labeled are never changed; unclear lines keep their label (label a few of those and run it again). Runs locally." />
                                <TextBlock Text="{Binding TranscriptSummary}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" ToolTip="{Binding TranscriptSummary}" />
                            </DockPanel>
                            <DataGrid x:Name="TranscriptGrid" Grid.Row="2" ItemsSource="{Binding Transcript}" SelectedItem="{Binding SelectedRow}"
                                      SelectionMode="Extended" RowHeight="NaN" MinRowHeight="30" ColumnHeaderHeight="32"
                                      MouseDoubleClick="TranscriptDoubleClick" SelectionChanged="TranscriptSelectionChanged"
                                      PreviewMouseRightButtonDown="TranscriptRightButtonDown" ContextMenuOpening="TranscriptContextMenuOpening"
                                      AutomationProperties.Name="Transcript lines"
                                      AutomationProperties.HelpText="Right-click lines to set or rename the speaker. Ctrl/Shift-click to select several. Double-click plays a line.">
                                <DataGrid.ContextMenu>
                                    <ContextMenu AutomationProperties.Name="Transcript line actions" />
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="80" />
                                    <DataGridTextColumn Header="Track" Binding="{Binding TrackName}" Width="90" />
                                    <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="120" />
                                    <DataGridTextColumn Header="Transcript" Binding="{Binding Text}" Width="*" MinWidth="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="Margin" Value="0,5" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Timing" Binding="{Binding Timing}" Width="80" />
                                    <DataGridTextColumn Header="Attribution" Binding="{Binding Attribution}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                                          ToolTip="Drag to resize the transcript and the line editor">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border Background="Transparent">
                                            <Border Width="44" Height="3" CornerRadius="1.5" Background="{StaticResource LineStrong}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <TabControl Grid.Row="4">
                                <TabItem Header="Selected line" x:Name="SelectedLineTab">
                                    <Grid Margin="8,6">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="■ Stop" Command="{Binding StopPlaybackCommand}" ToolTip="Stop playback" Margin="0,2,0,2" />
                                            <Button DockPanel.Dock="Right" Content="▶ Play" Command="{Binding PlayRowCommand}" ToolTip="Play this line from its own track" />
                                            <Button DockPanel.Dock="Right" Content="Restore raw" Command="{Binding RestoreRawCommand}" ToolTip="Drop your correction and show the recognized text again" />
                                            <Button DockPanel.Dock="Right" Content="Save text" Command="{Binding SaveCorrectionCommand}" ToolTip="Save the corrected text (left box). The recognized text (right box) is kept." />
                                            <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Muted}" Margin="0,0,8,0" ToolTip="{Binding RowDetails}" />
                                            <ComboBox Width="180" IsEditable="True" IsTextSearchEnabled="False" local:EditableComboBox.SyncSelection="True" ItemsSource="{Binding SpeakerNames}"
                                                      Text="{Binding LineSpeaker, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker for selected lines"
                                                      ToolTip="Pick a speaker or type a new name, then press Enter or Set speaker">
                                                <ComboBox.InputBindings><KeyBinding Key="Return" Command="{Binding SetLineSpeakerCommand}" /></ComboBox.InputBindings>
                                            </ComboBox>
                                            <Button Content="Set speaker" Command="{Binding SetLineSpeakerCommand}" HorizontalAlignment="Left"
                                                    ToolTip="Label the selected line(s). The app learns this voice and re-checks lines that are still Unknown." />
                                        </DockPanel>
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Correction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top" AutomationProperties.Name="Editable transcript correction" x:Name="CorrectionInput"
                                                     ToolTip="Edit the line's text here, then Save text" />
                                            <TextBox Grid.Column="1" Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top" Background="{StaticResource SurfaceAlt}" Foreground="{StaticResource Muted}"
                                                     AutomationProperties.Name="Preserved raw recognition" ToolTip="{Binding RowDetails}" Margin="0,2,0,2" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Speaker names">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8,6">
                                            <TextBlock Text="Rename a speaker on every line. Giving two speakers the same name merges them: their voice samples combine so future lines match better. Named speakers are remembered in the voice library, so later recordings name them automatically." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <WrapPanel>
                                                <ComboBox Width="190" ItemsSource="{Binding Speakers}" SelectedItem="{Binding ManagedSpeaker}" DisplayMemberPath="Name" AutomationProperties.Name="Speaker to rename" />
                                                <TextBox Width="220" Text="{Binding SpeakerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker display name">
                                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RenameSpeakerCommand}" /></TextBox.InputBindings>
                                                </TextBox>
                                                <Button Content="Rename throughout session" Command="{Binding RenameSpeakerCommand}" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,4,0,0">
                                                <Button Content="Match known voices" Command="{Binding RecognizeVoicesCommand}"
                                                        ToolTip="Names this session's unnamed speakers (Speaker 1, 2…) whose voice matches a remembered voice. Uses saved voice profiles only; no audio is re-analyzed." />
                                                <Button Content="Remember this session's named voices" Command="{Binding RememberSessionVoicesCommand}"
                                                        ToolTip="Adds every named speaker in this session to the voice library, for sessions named before voices were remembered." />
                                            </WrapPanel>
                                            <TextBlock Text="The microphone track is usually one person (you). Name it once and every microphone line, including ones transcribed later, gets that speaker." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,4" />
                                            <WrapPanel>
                                                <Button Content="Name all microphone lines…" Command="{Binding NameMicrophoneLinesCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Track playback">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8,6">
                                            <TextBlock Text="Play one original track from a time. Unlinked VTT tracks have no audio." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                                            <WrapPanel>
                                                <ComboBox Width="260" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="Name" AutomationProperties.Name="Original track to play" />
                                                <TextBox Width="140" Text="{Binding PlaybackTimestamp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Original track playback timestamp" />
                                                <Button Content="▶ Play track" Command="{Binding PlayTrackCommand}" />
                                                <Button Content="■ Stop playback" Command="{Binding StopPlaybackCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Te_mplates" Tag="&#xE99A;">
                        <Grid Margin="16,14,16,4" DataContext="{Binding Templates}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="420" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="320" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <Border Style="{StaticResource HeroCard}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Output templates" />
                                            <TextBlock Style="{StaticResource Help}" Text="Write a prompt once and an AI model keeps turning the transcript into what you need: DM guidance for the current scene, a running summary, a list of NPCs or items. Templates set to keep updating re-run whenever new lines arrive (at most once per interval) on the session being recorded, or the session selected on the left." />
                                            <TextBlock Text="{Binding TargetDescription}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MinHeight="90" MaxHeight="200"
                                                     Background="{StaticResource InputBg}" AutomationProperties.Name="Output templates">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource Dim}" Margin="12,0,0,0" />
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="New template" Command="{Binding AddTemplateCommand}" />
                                                <Button Content="Duplicate" Command="{Binding DuplicateTemplateCommand}" />
                                                <Button Content="Delete…" Command="{Binding DeleteTemplateCommand}" />
                                                <Button Content="Add starter templates" Command="{Binding AddStartersCommand}" ToolTip="Adds DM guidance, session summary, NPCs and items templates." />
                                                <Button Content="Add table (VTT) templates" Command="{Binding AddTableStartersCommand}" ToolTip="Adds turn order, token positions and DM reminders templates. They read a screenshot of your virtual tabletop window (set it in the Table screenshot card) and need a vision model such as gemma4:e4b." />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" IsEnabled="{Binding HasTemplate}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Selected template" />
                                            <Label Content="Name" Target="{Binding ElementName=TemplateNameInput}" />
                                            <TextBox x:Name="TemplateNameInput" Text="{Binding SelectedTemplate.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" AutomationProperties.Name="Template name" />
                                            <Label Content="Prompt: what should the model produce?" Target="{Binding ElementName=TemplatePromptInput}" />
                                            <TextBox x:Name="TemplatePromptInput" Text="{Binding SelectedTemplate.Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="110" MaxHeight="260" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,3,0,8" AutomationProperties.Name="Template prompt" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Label Content="LLM connection" Target="{Binding ElementName=TemplateConnectionInput}" />
                                                    <ComboBox x:Name="TemplateConnectionInput" ItemsSource="{Binding Connections}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedTemplate.ConnectionId}" Margin="0,3,0,8" AutomationProperties.Name="LLM connection for this template"
                                                              ToolTip="When none is chosen, the first connection below is used." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label Content="Every (seconds)" Target="{Binding ElementName=TemplateIntervalInput}" />
                                                    <TextBox x:Name="TemplateIntervalInput" Text="{Binding SelectedTemplate.IntervalSeconds, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8"
                                                             AutomationProperties.Name="Minimum seconds between automatic updates" ToolTip="Minimum time between automatic updates (10 or more). Updates only happen when its inputs changed." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <Label Content="Transcript characters" Target="{Binding ElementName=TemplateCharsInput}" />
                                                    <TextBox x:Name="TemplateCharsInput" Text="{Binding SelectedTemplate.MaxTranscriptChars, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8" IsEnabled="{Binding SelectedTemplate.UseTranscript}"
                                                             AutomationProperties.Name="Maximum transcript characters sent" ToolTip="Only the most recent part of a long transcript is sent (about 4 characters per token). Lower it for small local models." />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox IsChecked="{Binding SelectedTemplate.AutoUpdate}" FontWeight="SemiBold" Content="Keep updating when its inputs change" />
                                            <Border BorderBrush="{StaticResource Dim}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="Context (inputs)" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="What this template's model gets. Small local models do best with one narrow job each; chain templates and combine their outputs in a final one." />
                                                    <CheckBox IsChecked="{Binding SelectedTemplate.UseTranscript}" Content="Transcript (most recent part of the session)" ToolTip="Untick for templates that only work from other inputs; they then run without a session." />
                                                    <CheckBox IsChecked="{Binding SelectedTemplate.UseReferences}" Content="Reference files (below)" ToolTip="Sends the always-included files and lets the model search and read the context folder." />
                                                    <CheckBox IsChecked="{Binding SelectedTemplate.IncludePrevious}" Content="Previous output (update it instead of starting over)" />
                                                    <CheckBox IsChecked="{Binding SelectedTemplate.UseScreenshot}" Content="Include a screenshot of the table" ToolTip="Attaches a screenshot of the window or screen chosen under Table screenshot below. Needs a vision model (for example gemma4:e4b). Also re-runs when the screen changes." />
                                                    <TextBlock Text="Outputs of other templates" Margin="0,6,0,2" />
                                                    <ItemsControl ItemsSource="{Binding TemplateInputs}" AutomationProperties.Name="Other templates used as inputs">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" Content="{Binding Template.Name}"
                                                                          ToolTip="{Binding Hint}" ToolTipService.ShowOnDisabled="True" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <CheckBox IsChecked="{Binding SelectedTemplate.WriteToFile}" Content="Also write the output to a file" Margin="0,6,0,2" />
                                            <DockPanel IsEnabled="{Binding SelectedTemplate.WriteToFile}">
                                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputCommand}" Margin="0,3,0,8" />
                                                <TextBox Text="{Binding SelectedTemplate.OutputPath, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" AutomationProperties.Name="Template output file path" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="The file is rewritten on every update and never locked, so VS Code, Obsidian or a browser can keep it open. Edits made in other apps are overwritten." />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="▶  Update now" Style="{StaticResource PrimaryButton}" Command="{Binding RunTemplateCommand}" />
                                                <Button Content="■  Stop" Command="{Binding StopTemplateCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Reference files (shared by all templates)" />
                                            <TextBlock Style="{StaticResource Help}" Text="Context folder: the model can list, search and read the PDFs, Word documents, Markdown and text files in it (and its subfolders) when it needs them, for example adventure books, rules or campaign notes. It cannot read anything outside it, and it never changes files." />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFolderCommand}" Margin="0,3,0,8" />
                                                <TextBox Text="{Binding ContextFolder, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" AutomationProperties.Name="Context folder" />
                                            </DockPanel>
                                            <DockPanel Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="Add files…" Command="{Binding AddPinnedFilesCommand}" Margin="0,0,0,4" />
                                                <Label Content="Always-included files (one path per line)" Target="{Binding ElementName=PinnedFilesInput}" />
                                            </DockPanel>
                                            <TextBox x:Name="PinnedFilesInput" Text="{Binding PinnedFiles, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60" MaxHeight="140"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,3,0,8" AutomationProperties.Name="Always-included reference files" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Always-included files are sent in full with every update (up to about 60,000 characters in total), so keep them short: a campaign summary, party roster or cheat sheet. Put big books in the context folder instead. Files are read without locking them." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Table screenshot (shared by all templates)" />
                                            <TextBlock Style="{StaticResource Help}" Text="Pick your Roll20 or Foundry browser window (or a whole screen). Templates with &quot;Include a screenshot of the table&quot; get a fresh screenshot on each update; all templates updating together share the same frame. Window capture works when other windows cover it, but not when it is minimized. Screenshots are sent to the template's LLM connection." />
                                            <Label Content="Capture" Target="{Binding ElementName=CaptureTargetInput}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCaptureSourcesCommand}" Margin="0,3,0,8" ToolTip="Reload the list of screens and open windows." />
                                                <ComboBox x:Name="CaptureTargetInput" IsEditable="True" IsTextSearchEnabled="False" local:EditableComboBox.SyncSelection="True"
                                                          ItemsSource="{Binding CaptureSources}" Text="{Binding CaptureTarget, UpdateSourceTrigger=LostFocus}" Margin="0,3,8,8"
                                                          AutomationProperties.Name="Screen or window to capture"
                                                          ToolTip="A window is matched by its exact title, then by any title containing this text, so you can shorten it to e.g. Roll20." />
                                            </DockPanel>
                                            <WrapPanel>
                                                <Label Content="Max width (pixels)" Target="{Binding ElementName=CaptureWidthInput}" VerticalAlignment="Center" />
                                                <TextBox x:Name="CaptureWidthInput" Width="80" Text="{Binding CaptureMaxWidth, UpdateSourceTrigger=LostFocus}" Margin="8,3,12,8"
                                                         AutomationProperties.Name="Maximum screenshot width in pixels" ToolTip="Screenshots are scaled down to this width (aspect kept). Smaller is faster for local models." />
                                                <Button Content="Test capture" Command="{Binding TestCaptureCommand}" Margin="0,3,0,8" />
                                            </WrapPanel>
                                            <Image Source="{Binding CapturePreview}" MaxHeight="220" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,4" AutomationProperties.Name="Last screenshot" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CaptureCaption}" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="LLM connections" />
                                            <TextBlock Style="{StaticResource Help}" Text="Templates run on any OpenAI-compatible endpoint: OpenRouter, NVIDIA Build, OpenAI, Ollama or LM Studio on this PC or another machine, or your own server. Running a template sends the transcript text, and any reference text the model reads, to that endpoint; Ollama and LM Studio keep everything on your machines." />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddConnectionCommand}" Margin="0,3,0,8" />
                                                <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" Margin="0,3,8,8" AutomationProperties.Name="Type of connection to add" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PresetHelp}" Margin="0,0,0,8" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Remove…" Command="{Binding RemoveConnectionCommand}" Margin="0,3,0,8" />
                                                <ComboBox ItemsSource="{Binding Connections}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedConnection}" Margin="0,3,8,8" AutomationProperties.Name="Connection to edit" />
                                            </DockPanel>
                                            <StackPanel IsEnabled="{Binding HasConnection}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Label Content="Connection name" Target="{Binding ElementName=ConnectionNameInput}" />
                                                        <TextBox x:Name="ConnectionNameInput" Text="{Binding SelectedConnection.Name, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8" AutomationProperties.Name="Connection name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Label Content="Base URL" Target="{Binding ElementName=ConnectionUrlInput}" />
                                                        <TextBox x:Name="ConnectionUrlInput" Text="{Binding SelectedConnection.BaseUrl, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8" AutomationProperties.Name="Connection base URL"
                                                                 ToolTip="The OpenAI-compatible API root, usually ending in /v1. For Ollama on another machine: http://that-pc:11434/v1" />
                                                    </StackPanel>
                                                </Grid>
                                                <Label Content="Model" Target="{Binding ElementName=ConnectionModelInput}" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Load models" Command="{Binding LoadModelsCommand}" Margin="0,3,0,8" />
                                                    <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Models}" SelectedItem="{Binding PickedModel}" Margin="8,3,8,8"
                                                              AutomationProperties.Name="Models offered by the server" ToolTip="Choose Load models, then pick a model here." />
                                                    <TextBox x:Name="ConnectionModelInput" Text="{Binding SelectedConnection.Model, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,3,0,8" AutomationProperties.Name="Model name" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding SelectedConnection.KeyStatus}" Style="{StaticResource Caption}" />
                                                <WrapPanel>
                                                    <PasswordBox x:Name="LlmKeyInput" Width="300" Padding="8" Margin="0,4,10,4" AutomationProperties.Name="API key for this connection, password input" />
                                                    <Button Content="Save key" Click="SaveLlmKeyClick" />
                                                    <Button Content="Remove key" Click="ClearLlmKeyClick" />
                                                    <Button Content="Test" Command="{Binding TestConnectionCommand}" />
                                                    <Button Content="Check image support" Command="{Binding CheckImageSupportCommand}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="{Binding SelectedConnection.ImageSupportStatus}" Style="{StaticResource Caption}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="Keys are encrypted for your Windows account (DPAPI) in the library folder and only sent to this connection's URL. Models must support tool calling to read the context folder; others still get the transcript and always-included files. Test also asks the server whether the model reads images (needed for screenshots); Ollama's default gemma4:e4b does." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyOutputCommand}" Padding="10,3" MinHeight="28" Margin="0,0,0,6" />
                                        <ContentControl Style="{StaticResource SectionHeader}" Content="{Binding SelectedTemplate.Name}" Margin="0,0,12,6" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTemplate.Status}" Style="{StaticResource Caption}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                                    <TextBox Text="{Binding SelectedTemplate.Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" AutomationProperties.Name="Template output" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="_Jobs" Tag="&#xE9D5;">
                        <Grid Margin="16,14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Transcription queue" />
                                    <TextBlock Text="{Binding QueueSummary}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                    <WrapPanel>
                                        <Button Content="_Pause transcription" Command="{Binding PauseCommand}" />
                                        <Button Content="_Resume transcription" Command="{Binding ResumeCommand}" />
                                        <Button Content="_Cancel transcription jobs" Command="{Binding CancelJobsCommand}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="These controls affect transcription for the selected session, NOT audio capture. Recording Stop remains visible in the title bar. Latest 100 jobs below; aggregate counts include all jobs. Authentication, quota, and consent failures need explicit action, never a provider fallback." />
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" AutomationProperties.Name="Selected session latest transcription jobs">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
                                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="160" />
                                    <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="90" />
                                    <DataGridTextColumn Header="Error / diagnostic" Binding="{Binding Error}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="_Privacy / models" Tag="&#xE72E;">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16,14,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Recommended setup for this PC" />
                                            <TextBlock Style="{StaticResource Help}" Text="The app reads this PC's CPU, RAM and graphics card memory and works out what fits, like a self-hosting calculator. A local template LLM (Ollama on this PC) gets the GPU first because it is unusably slow on the CPU; Parakeet goes on the GPU only if there is room left, since it is already fast on the CPU; Whisper gets the largest size the remaining GPU memory or CPU can keep up with. Memory figures are planning estimates. Until you change a setting yourself, these are the defaults." />
                                            <TextBlock Text="{Binding HardwareText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,4" AutomationProperties.LiveSetting="Polite" />
                                            <WrapPanel>
                                                <Button Content="Apply recommended settings…" Command="{Binding ApplyRecommendedCommand}" />
                                                <Button Content="Re-check hardware" Command="{Binding RecheckHardwareCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Prerequisites" />
                                            <TextBlock Text="{Binding PrerequisiteStatus}" TextWrapping="Wrap" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding PrerequisitesReady}" Value="False"><Setter Property="Foreground" Value="{StaticResource ErrorText}" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Help}" Text="FFmpeg and FFprobe ship in the release's ffmpeg folder (LGPL build); an FFmpeg on PATH or installed with WinGet is also found. Local Whisper needs Microsoft's Visual C++ 2015-2022 runtime (x64); if it is missing, the app runs Microsoft's installer on startup (approve the Windows prompt)." />
                                            <WrapPanel>
                                                <Button Content="Install Visual C++ runtime…" Command="{Binding InstallVcRuntimeCommand}" Visibility="{Binding VcRuntimeMissing, Converter={StaticResource BoolVisibility}}" />
                                                <Button Content="Re-check prerequisites" Command="{Binding RecheckPrerequisitesCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Updates" />
                                            <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Help}" />
                                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                            <CheckBox IsChecked="{Binding AutoUpdate}" Content="Automatically download new releases and install them when the app closes" />
                                            <WrapPanel>
                                                <Button Content="Check for updates now" Command="{Binding CheckForUpdatesCommand}" />
                                                <Button Content="{Binding RestartToUpdateLabel}" Command="{Binding RestartToUpdateCommand}" Visibility="{Binding UpdateReady, Converter={StaticResource BoolVisibility}}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Help}" Text="Updates are the Windows ZIP from the latest GitHub release, verified against its published SHA-256 before use. They replace only the application folder; your library, recordings, settings, and models are untouched. Nothing installs while the app is running." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Diagnostics and bug reports" />
                                            <TextBlock Style="{StaticResource Help}" Text="The app keeps a local diagnostic log of what it did and any errors (the last 14 days). Something went wrong? Save diagnostics as a ZIP and attach it to a GitHub issue. The ZIP holds the logs, the update log, the Activity panel, and a system summary (Windows, .NET, GPU, prerequisites, model status). It never includes audio, transcript text, your library database, or keys; your Windows user name is replaced. Open it to review before sharing." />
                                            <TextBlock Text="{Binding LogFolderText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <Button Content="Save diagnostics ZIP…" Command="{Binding SaveDiagnosticsCommand}" AutomationProperties.Name="Save diagnostics ZIP" />
                                                <Button Content="Open log folder" Command="{Binding OpenLogsFolderCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Local Parakeet (default transcription)" />
                                            <TextBlock Style="{StaticResource Help}" Text="NVIDIA Parakeet TDT 0.6B v3 (CC BY 4.0), int8 ONNX export from sherpa-onnx: 465 MiB download, about 640 MB on disk, downloaded and SHA256-verified automatically on first start. It runs on the CPU (about 14–20× real time on a desktop CPU, ~1 GB RAM), needs no key, and uploads nothing. In testing it made about a third fewer word errors than Whisper large-v3-turbo while using far less CPU. 25 European languages, detected automatically; choose Local Whisper for other languages." />
                                            <TextBlock Text="{Binding ParakeetStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SetupStatus}" Visibility="{Binding HasSetupStatus, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <Button Content="Install / repair Parakeet model…" Command="{Binding InstallParakeetModelCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Local Whisper (optional)" />
                                            <TextBlock Style="{StaticResource Help}" Text="Whisper (MIT) downloads and is SHA256-verified the first time you record or import with Local Whisper, in the size recommended for this PC (large-v3-turbo, about 1.51 GiB, on most PCs; small or base on weaker ones). Choose it for languages Parakeet doesn't support or if you prefer its output. It runs on your GPU through Vulkan (NVIDIA, AMD, or Intel) when the recommended setup has room for it, otherwise on the CPU, where it is much heavier than Parakeet. The runtime used is shown in the status bar after each chunk. Whisper transcribes all voices but does not label speakers; speaker analysis does that." />
                                            <WrapPanel>
                                                <Button Content="{Binding InstallWhisperLabel}" Command="{Binding InstallWhisperModelCommand}" />
                                                <Button Content="Choose existing Whisper model…" Command="{Binding ChooseWhisperModelCommand}" />
                                            </WrapPanel>
                                            <CheckBox IsChecked="{Binding WhisperOnGpu}" Content="Run Whisper on the GPU (Vulkan); off uses the CPU and leaves GPU memory to the LLM and Parakeet" />
                                            <TextBlock Text="{Binding LocalModel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Your data, your decision" />
                                            <TextBlock Text="{Binding ConsentSummary}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Help}" Text="Consent applies only to the selected session's configured NVIDIA provider and audio tracks; for a local Whisper session it allows only the low-confidence fallback to hosted Parakeet. NVIDIA service terms/logging and finite account/model quotas apply. Upload only permitted audio, with no personal or confidential data. Revocation stops future uploads, but cannot recall already sent audio. Choosing local Whisper never opts into cloud on an error." />
                                            <CheckBox IsChecked="{Binding SelectedCloudConsent}" IsEnabled="{Binding HasSession}">
                                                <TextBlock Text="I explicitly permit NVIDIA uploads for the selected session under the disclosure above." TextWrapping="Wrap" />
                                            </CheckBox>
                                            <WrapPanel>
                                                <Button Content="Grant selected-session consent" Command="{Binding GrantConsentCommand}" />
                                                <Button Content="Revoke cloud consent" Command="{Binding RevokeConsentCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="NVIDIA key — never required to record" />
                                            <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Help}" />
                                            <WrapPanel>
                                                <PasswordBox x:Name="NvidiaKeyInput" Width="330" Padding="8" Margin="0,4,10,4" AutomationProperties.Name="NVIDIA key, password input, never logged" />
                                                <Button Content="Use entered key" Click="SaveKeyClick" />
                                                <Button Content="Clear key" Click="ClearKeyClick" />
                                            </WrapPanel>
                                            <CheckBox Content="Remember key with Windows current-user DPAPI (off by default)" IsChecked="{Binding RememberKey}" />
                                            <TextBlock Text="Memory-only by default. The password field is cleared after use. No keys in configuration, logs, command-line arguments, transcripts, or exports. Graph authentication is separate. Local Parakeet, on the CPU or GPU, never uses the key." Style="{StaticResource Help}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Automatic local speaker analysis" />
                                            <TextBlock Style="{StaticResource Help}" Text="About 33.49 MB total, downloaded automatically on first start so speakers are labeled by default. Segmentation is MIT (CNRS 2023); embedding is CC BY 4.0 with retained attribution and package notices. Official release artifacts need no Hugging Face token. Use the button below to retry if the automatic download failed." />
                                            <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <WrapPanel>
                                                <Button Content="Install small diarization models…" Command="{Binding InstallModelsCommand}" />
                                                <Button Content="Analyze selected session speakers" Command="{Binding DiarizeCommand}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Help}" Text="Automatic labels are not verified participant identities. Short turns, overlap, changing character voices, and crowded windows can remain uncertain. More session speakers are possible, but the segmentation model has local-window limits. Manual rename and assignment are available in Transcript." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Voice library (remembered speakers)" />
                                            <TextBlock Style="{StaticResource Help}" Text="When you name a speaker, by renaming them or labeling their lines, a few voice samples are saved here. Samples are 256-number voice embeddings, not audio. Later recordings, and Match known voices on older sessions, compare new speakers with these samples and name the matching person automatically. Only close, clear matches are named; the rest stay Speaker 1, 2… Voices are stored only on this PC and never exported or uploaded. Different mics, heavy compression, or character voices can prevent a match; naming someone in two or three sessions helps." />
                                            <CheckBox IsChecked="{Binding RememberVoices}" Content="Remember speakers I name and recognize them in future recordings" />
                                            <TextBlock Text="{Binding VoiceLibrarySummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,4" />
                                            <ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Summary" MinHeight="60" MaxHeight="180"
                                                     AutomationProperties.Name="Remembered voices" />
                                            <WrapPanel Margin="0,4,0,0">
                                                <Button Content="Learn from past sessions" Command="{Binding RememberAllVoicesCommand}"
                                                        ToolTip="Remember every speaker you named in any session that has a voice profile. Runs once automatically; use it again any time." />
                                                <Button Content="Rename…" Command="{Binding RenameVoiceCommand}" />
                                                <Button Content="Forget selected voice" Command="{Binding ForgetVoiceCommand}" />
                                                <Button Content="Forget all voices…" Command="{Binding ForgetAllVoicesCommand}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Help}" Text="Forgetting deletes the remembered samples at once. Past sessions keep their speaker names and their own in-session voice profiles." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Parakeet on the NVIDIA GPU" />
                                            <TextBlock Style="{StaticResource Help}" Text="At startup the app looks for an NVIDIA GPU that can run Parakeet with CUDA 12 (GTX 10-series or newer, 4 GB+, driver 527.41+). The first time it finds one, and the recommended setup has room for Parakeet beside a local template LLM, it asks once whether to download the GPU runtime (about 4.4 GB: NVIDIA's CUDA runtime, cuBLAS and cuDNN, ONNX Runtime's CUDA build, and the full-precision Parakeet model), which needs accepting NVIDIA's license terms. Then Parakeet runs on the GPU in a separate worker process: much faster on long imports, with almost no CPU load and the same accuracy. If anything goes wrong it falls back to the CPU model. No Docker, admin rights, or system install." />
                                            <TextBlock Text="{Binding LocalGpuStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <WrapPanel>
                                                <Button Content="Use the GPU for Parakeet…" Command="{Binding UseGpuCommand}" />
                                                <Button Content="Use the CPU only" Command="{Binding UseCpuCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding DataRoot, StringFormat=Local library: {0}}" Style="{StaticResource Caption}" Margin="2,0,0,8" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="_VTT / Teams" Tag="&#xE8B5;">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16,14,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Transcript sources with provenance" />
                                            <TextBlock Style="{StaticResource Help}" Text="First select an existing session. Import a local WebVTT file to add timed cues and source speaker labels. Cue times retain the source transcript clock; they are not automatically aligned to this session's audio. Labels are retained as transcript provenance, not inferred verified identities. An unlinked transcript does not manufacture playable audio." />
                                            <Button Content="Import local .vtt into selected session…" Command="{Binding ImportVttCommand}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <ContentControl Style="{StaticResource SectionHeader}" Content="Not included: live Teams audio" />
                                            <TextBlock Style="{StaticResource Help}" Text="Live Teams requires a separately deployed Azure media bot and tenant policy, so it is not represented by a fake capture button. Record Windows output instead, or fetch the meeting transcript here. Discord server voice channels are recorded on the Discord tab." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Microsoft Teams · configuration required" />
                                        <TextBlock Style="{StaticResource Help}" Text="This uses real delegated Microsoft Graph retrieval of an existing meeting transcript—not live Teams audio. Supply a work/school tenant, public-client app ID configured for device-code sign-in, and explicit user, online-meeting, and transcript IDs. OnlineMeetingTranscript.Read.All permission, meeting access, and tenant policy must permit retrieval." />
                                        <Button Content="Fetch configured Teams transcript…" Command="{Binding FetchTeamsCommand}" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource Help}" Text="The sign-in window displays the actual Microsoft verification URL, device code, and expiration—not tokens. Attribution restrictions are respected; an explicitly permitted unattributed policy option is available. No tenant or live Graph validation is implied by the UI smoke test." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="2" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,3">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" Margin="0,3" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorText}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Height="8" Margin="15,0" Foreground="{StaticResource GoldFill}" AutomationProperties.Name="Current operation progress" />
                <Button Grid.Column="2" Content="Cancel operation" Command="{Binding CancelOperationCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" MinHeight="26" Padding="10,2" Margin="0,2" ToolTip="Cancels the current import, download, or analysis. Does not stop an active recording." />
            </Grid>
        </Border>
    </Grid>
</Window>
