<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- NAudio.Core is portable; NAudio.Wasapi is used only on Windows (Linux capture/playback goes through PulseAudio). -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\AudioTranscriber.Core\AudioTranscriber.Core.csproj" />
  </ItemGroup>
</Project>
