<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
    <!-- Vendored natives (see NativeSqlite\README.md); scripts\Publish.ps1 keeps only the target platform's library. -->
    <None Update="NativeSqlite\e_sqlite3.dll" Link="e_sqlite3.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="NativeSqlite\libe_sqlite3.so" Link="libe_sqlite3.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
